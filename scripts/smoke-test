#!/usr/bin/env bash
set -euo pipefail

php craft plugin/list

php craft exec '
use Craft;
use craft\base\PluginInterface;
use lindemannrock\shortlinkmanager\ShortLinkManager;
use lindemannrock\shortlinkmanager\models\Settings;
use lindemannrock\logginglibrary\LoggingLibrary;

$plugins = Craft::$app->getPlugins();
$plugin = $plugins->getPlugin("shortlink-manager");

if (!$plugin instanceof ShortLinkManager) {
    throw new RuntimeException("ShortLink Manager plugin class was not loaded.");
}

foreach (["shortlink-manager", "logging-library"] as $handle) {
    if (!$plugins->isPluginInstalled($handle) || !$plugins->isPluginEnabled($handle)) {
        throw new RuntimeException("Required Craft plugin is not installed and enabled: {$handle}");
    }
}

if (!$plugins->getPlugin("logging-library") instanceof LoggingLibrary) {
    throw new RuntimeException("Logging Library dependency was not loaded.");
}

$baseModule = Craft::$app->getModule("lindemannrock-base");
if (!$baseModule instanceof \yii\base\Module) {
    throw new RuntimeException("Base module was not registered.");
}

$settings = $plugin->getSettings();
if (!$settings instanceof Settings) {
    throw new RuntimeException("ShortLink Manager settings model was not loaded.");
}

if ($settings->slugPrefix !== "s" || $settings->defaultQrSize !== 256 || $settings->enableAnalytics !== true) {
    throw new RuntimeException("ShortLink Manager fresh-install settings defaults are not intact.");
}

foreach (["shortLinks", "analytics", "qrCode", "deviceDetection", "integration", "taxonomy"] as $component) {
    if (!$plugin->has($component)) {
        throw new RuntimeException("Missing ShortLink Manager service component: {$component}");
    }
    $plugin->get($component);
}

echo "ShortLink Manager smoke test passed.\n";
'
