{
    "name": "lindemannrock/craft-shortlink-manager",
    "description": "Advanced shortlink management with QR codes, analytics for Craft CMS",
    "type": "craft-plugin",
    "version": "5.28.3",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "shortlink",
        "url-shortener",
        "qr-code",
        "analytics"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Bilal Hary Lindemann",
            "email": "bh@lindemannrock.com",
            "homepage": "https://lindemannrock.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@lindemannrock.com",
        "issues": "https://github.com/LindemannRock/craft-shortlink-manager/issues",
        "source": "https://github.com/LindemannRock/craft-shortlink-manager",
        "docs": "https://github.com/LindemannRock/craft-shortlink-manager/blob/main/README.md",
        "rss": "https://github.com/LindemannRock/craft-shortlink-manager/commits/main.atom"
    },
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.10",
        "lindemannrock/craft-plugin-base": "^5.38",
        "lindemannrock/craft-logging-library": "^5.17",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "nystudio107/craft-seomatic": "^5.0",
        "phpunit/phpunit": "^11.0",
        "yiisoft/yii2-redis": "^2.0",
        "lindemannrock/craft-redirect-manager": "^5.40"
    },
    "autoload": {
        "psr-4": {
            "lindemannrock\\shortlinkmanager\\": "src/",
            "lindemannrock\\shortlinkmanager\\tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": [
            "@php -r \"fwrite(STDOUT, 'PHPStan scope: src/ tests/' . PHP_EOL);\"",
            "phpstan --ansi --memory-limit=1G"
        ],
        "check-cs": [
            "@php -r \"fwrite(STDOUT, 'ECS scope: src/ tests/ ecs.php' . PHP_EOL);\"",
            "ecs check --ansi"
        ],
        "fix-cs": [
            "@php -r \"fwrite(STDOUT, 'ECS fix scope: src/ tests/ ecs.php' . PHP_EOL);\"",
            "ecs check --fix --ansi"
        ],
        "test": "phpunit --colors=always",
        "ci": [
            "@phpstan",
            "@check-cs"
        ],
        "ci:full": [
            "@ci",
            "@test"
        ],
        "quality-gate": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/quality-gate.mjs"
        ],
        "install-hooks": "git config core.hooksPath .githooks 2>/dev/null || true",
        "post-install-cmd": "@install-hooks",
        "post-update-cmd": "@install-hooks"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "name": "ShortLink Manager",
        "handle": "shortlink-manager",
        "developer": "LindemannRock",
        "developerUrl": "https://lindemannrock.com",
        "documentationUrl": "https://github.com/LindemannRock/craft-shortlink-manager/blob/main/README.md",
        "changelogUrl": "https://github.com/LindemannRock/craft-shortlink-manager/blob/main/CHANGELOG.md",
        "class": "lindemannrock\\shortlinkmanager\\ShortLinkManager"
    }
}
