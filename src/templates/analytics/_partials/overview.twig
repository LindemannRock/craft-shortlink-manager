{# Overview Tab - Stats, Daily Interactions, Top Links, Recent Interactions #}

<div class="lr-unified-cards">
    {% include 'lindemannrock-base/_components/unified-card' with {
        value: analyticsData.totalClicks ?? 0,
        description: 'Total Interactions'|t('shortlink-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: analyticsData.uniqueVisitors ?? 0,
        description: 'Unique Visitors'|t('shortlink-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: analyticsData.activeLinks ?? 0,
        description: 'Active Links'|t('shortlink-manager'),
        align: 'center',
    } only %}

    {% include 'lindemannrock-base/_components/unified-card' with {
        value: (analyticsData.linksUsedPercentage ?? 0) ~ '%',
        description: 'Engagement Rate'|t('shortlink-manager'),
        align: 'center',
    } only %}
</div>

<h2 class="lr-section-heading">{{ "Traffic Overview"|t('shortlink-manager') }}</h2>

<div class="lr-analytics-charts">
    <div class="lr-chart-container full-width">
        <h3>{{ "Daily Interactions"|t('shortlink-manager') }}</h3>
        <canvas id="clicks-chart"></canvas>
    </div>
</div>

<h2 class="lr-section-heading">{{ "Top {pluginName} (Top 20)"|t('shortlink-manager', {pluginName: shortlinkHelper.pluralDisplayName}) }}</h2>

<div class="lr-analytics-charts">
    <div class="lr-chart-container full-width">
        <div class="lr-table-scroll">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Code"|t('shortlink-manager') }}</th>
                        <th>{{ "Site"|t('shortlink-manager') }}</th>
                        <th>{{ "Destination"|t('shortlink-manager') }}</th>
                        <th>{{ "Total Interactions"|t('shortlink-manager') }}</th>
                        <th>{{ "Last Interaction"|t('shortlink-manager') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for shortLink in analyticsData.topLinks ?? [] %}
                        {% if (shortLink.enabled ?? true) and (shortLink.clicks > 0) %}
                            <tr>
                                <td>
                                    <a href="{{ cpUrl('shortlink-manager/shortlinks/' ~ shortLink.id) }}">
                                        <code>{{ shortLink.code }}</code>
                                    </a>
                                </td>
                                <td>
                                    {% if shortLink.siteId %}
                                        {% set site = craft.app.sites.getSiteById(shortLink.siteId) %}
                                        {{ site ? site.name : '—' }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>
                                    <span title="{{ shortLink.destinationUrl }}">
                                        {{ shortLink.destinationUrl|length > 50 ? shortLink.destinationUrl|slice(0, 50) ~ '...' : shortLink.destinationUrl }}
                                    </span>
                                </td>
                                <td>{{ shortLink.clicks|number }}</td>
                                <td>{{ shortLink.lastClick ? shortLink.lastClick|lrDatetime : '-' }}</td>
                            </tr>
                        {% endif %}
                    {% else %}
                        <tr>
                            <td colspan="5" class="thin light lr-text-center">{{ "No data for selected period"|t('shortlink-manager') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<h2 class="lr-section-heading">{{ "Interactions (Last 20)"|t('shortlink-manager') }}</h2>

<div class="lr-analytics-charts">
    <div class="lr-chart-container full-width">
        <div class="lr-table-scroll">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Date"|t('shortlink-manager') }}</th>
                        <th>{{ "Time"|t('shortlink-manager') }}</th>
                        <th>{{ "Code"|t('shortlink-manager') }}</th>
                        <th>{{ "Site"|t('shortlink-manager') }}</th>
                        <th>{{ "Source"|t('shortlink-manager') }}</th>
                        <th>{{ "Destination"|t('shortlink-manager') }}</th>
                        <th>{{ "Agent"|t('shortlink-manager') }}</th>
                        <th>{{ "Device"|t('shortlink-manager') }}</th>
                        <th>{{ "Browser"|t('shortlink-manager') }}</th>
                        <th>{{ "OS"|t('shortlink-manager') }}</th>
                        {% if craft.app.plugins.getPlugin('shortlink-manager').settings.enableGeoDetection %}
                            <th>{{ "Location"|t('shortlink-manager') }}</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody id="recent-clicks-body">
                    <tr>
                        <td colspan="{{ craft.app.plugins.getPlugin('shortlink-manager').settings.enableGeoDetection ? '11' : '10' }}" class="thin light lr-text-center">
                            <div class="spinner"></div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
