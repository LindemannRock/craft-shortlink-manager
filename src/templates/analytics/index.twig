{#
 # Analytics Page
 #
 # Uses the base plugin's cp-analytics layout for consistent styling.
 #}

{% extends 'lindemannrock-base/_layouts/cp-analytics' %}

{% set plugin = craft.app.plugins.getPlugin('shortlink-manager') %}
{% set settings = plugin.settings %}
{% set pluginHandle = pluginHandle ?? plugin.id %}

{# Define tabs - Geographic only if geo detection enabled #}
{% set tabsConfig = {
    overview: { label: "Overview"|t('shortlink-manager') },
    'traffic-devices': { label: "Traffic & Devices"|t('shortlink-manager') }
} %}

{% if settings.enableGeoDetection %}
    {% set tabsConfig = tabsConfig|merge({
        geographic: { label: "Geographic"|t('shortlink-manager') }
    }) %}
{% endif %}

{% set analyticsConfig = {
    plugin: {
        handle: pluginHandle ?? 'shortlink-manager',
        name: shortlinkHelper.fullName,
    },
    page: {
        title: 'Analytics'|t('shortlink-manager'),
        subnav: 'analytics',
        crumbs: [
            { label: shortlinkHelper.fullName, url: url('shortlink-manager') },
            { label: 'Analytics'|t('shortlink-manager'), url: url('shortlink-manager/analytics') },
        ],
    },
    tabs: tabsConfig,
    filters: {
        dateRange: {
            current: dateRange,
        },
        sites: {
            enabled: sites|length > 1,
            current: siteId,
            sites: sites,
        },
    },
    export: {
        permission: 'shortLinkManager:exportAnalytics',
        action: 'shortlink-manager/analytics/export',
        extraParams: {siteId: siteId},
    },
    charts: {
        prefix: 'slm',
        dataEndpoint: 'shortlink-manager/analytics/get-data',
    },
} %}

{% block tabs %}
    <div id="overview" class="lr-tab-content">
        {% include 'shortlink-manager/analytics/_partials/overview' %}
    </div>

    <div id="traffic-devices" class="lr-tab-content hidden">
        {% include 'shortlink-manager/analytics/_partials/traffic-devices' %}
    </div>

    {% if settings.enableGeoDetection %}
    <div id="geographic" class="lr-tab-content hidden">
        {% include 'shortlink-manager/analytics/_partials/geographic' %}
    </div>
    {% endif %}
{% endblock %}

{% block scripts %}
{% do view.registerAssetBundle('lindemannrock\\shortlinkmanager\\web\\assets\\analytics\\AnalyticsAsset') %}

{% set shortlinkStrings = {
    noInteraction: "No interaction data available for the selected filters."|t('shortlink-manager'),
    noDevice: "No device data available for the selected filters."|t('shortlink-manager'),
    noTrafficType: "No traffic type data available for the selected filters."|t('shortlink-manager'),
    noAgentData: "No agent data available"|t('shortlink-manager'),
    noBrand: "No device brand data available for the selected filters."|t('shortlink-manager'),
    noOs: "No OS data available for the selected filters."|t('shortlink-manager'),
    noBrowser: "No browser data available for the selected filters."|t('shortlink-manager'),
    noHourly: "No hourly data available for the selected filters."|t('shortlink-manager'),
    noCountry: "No country data available"|t('shortlink-manager'),
    noCity: "No city data available"|t('shortlink-manager'),
    noRecentClicks: "No interactions recorded yet"|t('shortlink-manager'),
    interactionsLabel: "Interactions"|t('shortlink-manager'),
    human: "Human"|t('shortlink-manager'),
    system: "System"|t('shortlink-manager'),
    bot: "Bot"|t('shortlink-manager'),
    peakUsageAt: "Peak usage at"|t('shortlink-manager'),
    sourceQr: "QR"|t('shortlink-manager'),
    sourceDirect: "Direct"|t('shortlink-manager'),
    shortlinksEditUrl: cpUrl('shortlink-manager/shortlinks'),
    geoEnabled: settings.enableGeoDetection ?? false,
} %}

{% set shortlinkAnalyticsConfig = {
    prefix: analyticsConfig.charts.prefix,
    dateRange: dateRange,
    siteId: siteId ?? '',
    csrfName: craft.app.config.general.csrfTokenName,
    csrfToken: craft.app.request.csrfToken,
    dataEndpoint: analyticsConfig.charts.dataEndpoint,
    strings: shortlinkStrings,
} %}

{% js %}
window.lrShortlinkAnalyticsInit({{ shortlinkAnalyticsConfig|json_encode|raw }});
{% endjs %}
{% endblock %}
