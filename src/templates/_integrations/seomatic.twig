{#
  SEOmatic integration tracking template
  Initializes independent landing-arrival and automatic-navigation events
#}
{% set shortlinkPlugin = craft.app.plugins.getPlugin('shortlink-manager') %}
{% set settings = shortlinkPlugin ? shortlinkPlugin.settings : null %}
{% set enabledIntegrations = settings.enabledIntegrations ?? [] %}
{% set trackingEvents = settings.seomaticTrackingEvents ?? ['redirect', 'qr_scan'] %}
{% set seomaticEnabled = settings
    and craft.app.plugins.isPluginEnabled('seomatic')
    and 'seomatic' in enabledIntegrations
    and eventType != 'qr_scan'
%}

{% if seomaticEnabled %}
    {% set eventPrefix = settings.seomaticEventPrefix ?? 'short_links' %}
    <script>
        window.dataLayer = window.dataLayer || [];

        function pushShortLinkEvent(eventType) {
            var trackingEvents = {{ trackingEvents|json_encode|raw }};
            if (trackingEvents.indexOf(eventType) === -1) {
                return;
            }

            var source = new URLSearchParams(window.location.search).get('src') || 'direct';
            var eventData = {
                event: {{ eventPrefix|json_encode|raw }} + '_' + eventType,
                shortlink: {
                    code: {{ link.code|json_encode|raw }},
                    title: {{ link.title|json_encode|raw }},
                    source: source,
                    click_type: eventType
                }
            };
            window.dataLayer.push(eventData);
            if (eventType === 'redirect' || eventType === 'qr_scan') {
                window.shortLinkAutoTrackingQueued = true;
            }
            {% if craft.app.config.general.devMode %}
            console.log('ShortLink Manager event pushed to dataLayer:', eventData);
            {% endif %}
        }

        if (new URLSearchParams(window.location.search).get('src') === 'qr') {
            pushShortLinkEvent('qr_scan');
        }
    </script>
{% endif %}
