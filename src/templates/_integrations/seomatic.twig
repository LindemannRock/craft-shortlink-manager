{#
  SEOmatic integration tracking template
  Pushes shortlink events to Google Tag Manager dataLayer
#}
{% set shortlinkPlugin = craft.app.plugins.getPlugin('shortlink-manager') %}
{% set settings = shortlinkPlugin ? shortlinkPlugin.settings : null %}
{% set enabledIntegrations = settings.enabledIntegrations ?? [] %}
{% set trackingEvents = settings.seomaticTrackingEvents ?? ['redirect', 'qr_scan'] %}
{% set seomaticEnabled = settings
    and craft.app.plugins.isPluginEnabled('seomatic')
    and 'seomatic' in enabledIntegrations
    and eventType in trackingEvents
%}

{% if seomaticEnabled %}
    {% set eventPrefix = settings.seomaticEventPrefix ?? 'shortlink_manager' %}
    {% set eventData = {
        event: eventPrefix ~ '_' ~ eventType,
        shortlink: {
            code: link.code,
            title: link.title,
            source: craft.app.request.getParam('src', 'direct'),
            click_type: eventType,
        },
    } %}
    {% set eventDataJson = eventData|json_encode %}
    <script>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({{ eventDataJson|raw }});

        {% if craft.app.config.general.devMode %}
            console.log('Shortlink Manager: Event pushed to dataLayer:', {{ eventDataJson|raw }});
            console.log('Current dataLayer length:', window.dataLayer.length);
        {% endif %}
    </script>
{% endif %}
