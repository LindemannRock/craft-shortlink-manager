{% extends "shortlink-manager/_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% set plugin = craft.app.plugins.getPlugin('shortlink-manager') %}
{% set currentSite = craft.app.sites.getSiteById(shortLink.siteId) %}

{% set title = shortLink.id ? shortLink.slug : "New {singularName}"|t('shortlink-manager', {singularName: shortlinkHelper.displayName}) %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'shortlinks' %}
{% set saveShortcutRedirect = 'shortlink-manager/shortlinks/{id}' %}
{% set retainScrollOnSaveShortcut = true %}
{% set canViewAnalytics = currentUser.can('shortLinkManager:viewAnalytics') %}
{% set shortlinkLowerNameHtml = shortlinkHelper.lowerDisplayName|e %}

{% do view.registerAssetBundle('lindemannrock\\shortlinkmanager\\web\\assets\\edit\\EditAsset') %}

{% if shortLink.id %}
    {% do view.registerAssetBundle('lindemannrock\\shortlinkmanager\\web\\assets\\qrpreview\\QrPreviewAsset') %}
{% endif %}

{% set tabs = {
    fields: {
        label: 'Details'|t('shortlink-manager'),
        url: '#fields',
    },
} %}

{# Add tabs from field layout #}
{% set fieldLayoutTabs = [] %}
{% set fieldLayout = shortLink.getFieldLayout() %}
{% if fieldLayout %}
    {% for tab in fieldLayout.getTabs() %}
        {% if tab.getElements() %}
            {% set fieldLayoutTabs = fieldLayoutTabs|merge([tab]) %}
            {% set tabId = 'tab-' ~ tab.id %}
            {% set tabs = tabs|merge({
                (tabId): {
                    label: tab.name,
                    url: '#' ~ tabId,
                }
            }) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Add analytics tab if globally enabled, permitted, shortLink exists, AND tracking is enabled for this shortLink #}
{% if canViewAnalytics and plugin.settings.enableAnalytics and shortLink.id and (shortLink.trackAnalytics ?? true) %}
    {% set tabs = tabs|merge({
        analytics: {
            label: 'Analytics'|t('shortlink-manager'),
            url: '#analytics',
        },
    }) %}
{% endif %}

{% set isNew = not shortLink.id %}

{# Set up breadcrumbs #}
{% set crumbs = [] %}

{# Site switcher (first item) #}
{% if craft.app.getIsMultiSite() %}
    {% set currentSite = craft.app.sites.getSiteById(shortLink.siteId ?? craft.app.sites.currentSite.id) %}

    {# Get site menu items #}
    {% set siteMenuItems = [] %}
    {% for site in enabledSites %}
        {% set siteMenuItems = siteMenuItems|merge([{
            label: site.name,
            url: shortLink.id ? url('shortlink-manager/shortlinks/' ~ shortLink.id, {site: site.handle}) : url('shortlink-manager/shortlinks/new', {site: site.handle}),
            selected: site.id == shortLink.siteId
        }]) %}
    {% endfor %}

    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: currentSite.name|t('site'),
        menu: {
            items: siteMenuItems,
            label: 'Select site'|t('shortlink-manager')
        }
    }] %}
{% endif %}

{# Main navigation #}
{% set crumbs = crumbs|merge([
    {
        label: shortlinkHelper.fullName|t('shortlink-manager'),
        url: url('shortlink-manager/shortlinks')
    }
]) %}

{% if shortLink.id %}
    {% set crumbs = crumbs|merge([{
        label: shortLink.slug,
        url: url('shortlink-manager/shortlinks/' ~ shortLink.id)
    }]) %}
{% endif %}

{% block actionButton %}
    {% if shortLink.id %}
        <div class="preview-btn-container btngroup">
            {% set viewLabel = shortlinkHelper.displayName %}
            <a href="{{ shortLink.getUrl() }}" target="_blank" class="btn">{{ 'View'|t('shortlink-manager') }}</a>
            <button type="button" class="btn menubtn"></button>
            <div class="menu">
                <ul role="listbox">
                    <li>
                        <a role="option" tabindex="0" href="{{ shortLink.getUrl() }}" target="_blank">
                            {{ viewLabel }}
                        </a>
                    </li>
                    {% if shortLink.qrCodeEnabled %}
                        <li>
                            <a role="option" tabindex="0" href="{{ shortLink.getQrCodeUrl() }}" target="_blank">
                                {{ "QR Code Image"|t('shortlink-manager') }}
                            </a>
                        </li>
                        <li>
                            <a role="option" tabindex="0" href="{{ shortLink.getQrCodeDisplayUrl() }}" target="_blank">
                                {{ "QR Code Page"|t('shortlink-manager') }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    {% endif %}
    <div class="btngroup submit">
        <button type="submit" class="btn submit">{{ "Save"|t('shortlink-manager') }}</button>
        <button type="button" class="btn submit menubtn"></button>
        <div class="menu">
            <ul role="listbox">
                <li>
                    <a class="formsubmit" role="option" tabindex="0" data-redirect="{{ url('shortlink-manager/shortlinks/{id}', {site: currentSite.handle})|hash }}">
                        <span class="label">{{ 'Save and continue editing'|t('shortlink-manager') }}</span>
                        <span class="shortcut" id="save-shortcut"></span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    {% if shortLink.id and currentUser.can('shortLinkManager:deleteLinks') %}
        <button type="button" id="action-btn" class="btn menubtn action-btn hairline-dark m" title="{{ 'Actions'|t('shortlink-manager') }}" aria-controls="action-menu" aria-label="{{ 'Actions'|t('shortlink-manager') }}" data-disclosure-trigger="true" aria-expanded="false"></button>
        <div id="action-menu" class="menu menu--disclosure">
            <ul>
                <li>
                    <button class="menu-item error formsubmit" data-destructive data-action="shortlink-manager/shortlinks/delete" data-params='{"id":{{ shortLink.id }}}' data-confirm="{{ 'Are you sure you want to delete this entry?'|t('shortlink-manager') }}" data-redirect="{{ 'shortlink-manager/shortlinks'|hash }}" data-headers='{"Accept":"application/json"}'>
                        <span class="icon">{{ svg('@app/icons/trash.svg') }}</span>
                        <span class="menu-item-label">{{ "Delete"|t('shortlink-manager') }}</span>
                    </button>
                </li>
            </ul>
        </div>
    {% endif %}
{% endblock %}

{# Display validation errors summary before content #}
{% if shortLink is defined and shortLink.hasErrors() %}
    {% set errorSummary %}
        {% include 'lindemannrock-base/_partials/error-summary' with {
            errors: shortLink.getErrors(),
        } %}
    {% endset %}
{% endif %}

{% block content %}
    <script type="application/json" data-shortlink-edit-config>{{ {
        newFolderFieldId: 'newFolderName'|namespaceInputId ~ '-field',
        urls: {
            generateCodeAction: 'shortlink-manager/shortlinks/generate-code',
            qrPublicBaseUrl: shortLink.id ? plugin.settings.buildPublicUrl((plugin.settings.qrPrefix ?: 'qr') ~ '/' ~ shortLink.slug, shortLink.siteId) : null,
        },
        defaults: {
            qrSize: plugin.settings.defaultQrSize ?? 256,
            qrColor: plugin.settings.defaultQrColor ?? '#000000',
            qrBgColor: plugin.settings.defaultQrBgColor ?? '#FFFFFF',
            qrEyeColor: plugin.settings.qrEyeColor ?? '',
            qrFormat: plugin.settings.defaultQrFormat ?? '',
        },
        messages: {
            httpStatusTips: {
                301: "<strong>301 - Moved Permanently:</strong> Use when content has permanently moved. Search engines will update their index."|t('shortlink-manager') ~ ' <a class="go" href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/301" target="_blank" rel="noopener">' ~ "Learn more"|t('shortlink-manager') ~ '</a>',
                302: "<strong>302 - Found (Temporary):</strong> Temporary redirect. Search engines won't update their index."|t('shortlink-manager') ~ ' <a class="go" href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/302" target="_blank" rel="noopener">' ~ "Learn more"|t('shortlink-manager') ~ '</a>',
                307: "<strong>307 - Temporary Redirect:</strong> Like 302 but guarantees the request method won't change (POST stays POST)."|t('shortlink-manager') ~ ' <a class="go" href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/307" target="_blank" rel="noopener">' ~ "Learn more"|t('shortlink-manager') ~ '</a>',
                308: "<strong>308 - Permanent Redirect:</strong> Like 301 but guarantees the request method won't change (POST stays POST)."|t('shortlink-manager') ~ ' <a class="go" href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Status/308" target="_blank" rel="noopener">' ~ "Learn more"|t('shortlink-manager') ~ '</a>',
            },
            generateNewCodeConfirm: "Generate a new code? This will change the shortlink URL and may break existing links."|t('shortlink-manager'),
            newCodeGenerated: "New code generated. Save to apply changes."|t('shortlink-manager'),
            generateCodeFailed: "Failed to generate code"|t('shortlink-manager'),
            enterCustomSize: "Enter custom size (100-4096 pixels):"|t('shortlink-manager'),
            invalidCustomSize: "Please enter a valid size between 100 and 4096 pixels"|t('shortlink-manager'),
            resetQrDefaultsConfirm: "Reset QR code settings to plugin defaults?"|t('shortlink-manager'),
            qrDefaultsReset: "QR code settings reset to defaults"|t('shortlink-manager'),
        },
    }|json_encode|raw }}</script>

    <input type="hidden" name="action" value="shortlink-manager/shortlinks/save">
    {# Default redirect goes back to index #}
    {{ redirectInput('shortlink-manager/shortlinks') }}
    {% if shortLink.id %}
        <input type="hidden" name="linkId" value="{{ shortLink.id }}">
    {% endif %}
    {% if craft.app.sites.getTotalEditableSites() > 1 %}
        <input type="hidden" name="siteId" value="{{ shortLink.siteId }}">
    {% endif %}

    <div id="fields">
        {% include "shortlink-manager/shortlinks/_partials/fields" %}

        {% include 'lindemannrock-base/_components/plugin-credit' %}
    </div>

    {# Custom field layout tabs #}
    {% for tab in fieldLayoutTabs %}
        {% set tabId = 'tab-' ~ tab.id %}
        <div id="{{ tabId }}" class="hidden">
            {% for element in tab.getElements() %}
                {{ element.formHtml(shortLink, shortLink.getIsRevision())|raw }}
            {% endfor %}

            {% include 'lindemannrock-base/_components/plugin-credit' %}
        </div>
    {% endfor %}

    {# Analytics tab #}
    {% if canViewAnalytics and plugin.settings.enableAnalytics and shortLink.id and (shortLink.trackAnalytics ?? true) %}
        <div id="analytics" class="hidden">
            {% include "shortlink-manager/shortlinks/_partials/analytics" %}

            {% include 'lindemannrock-base/_components/plugin-credit' %}
        </div>
    {% endif %}
{% endblock %}

{% block details %}
    <div class="meta">
        {# Code Field (read-only display) #}
        {% if shortLink.id %}
            <div class="field" data-attribute="code">
                <div class="heading">
                    <label>{{ "Code"|t('shortlink-manager') }}</label>
                </div>
                <div class="input ltr">
                    <div class="value"><code style="font-size: 13px;">{{ shortLink.code }}</code></div>
                </div>
            </div>
        {% endif %}

        {# Author field #}
        {{ forms.elementSelectField({
            label: "Author"|t('shortlink-manager'),
            id: 'authorId',
            name: 'authorId',
            elementType: 'craft\\elements\\User',
            elements: shortLink.id and shortLink.getAuthor() ? [shortLink.getAuthor()] : [currentUser],
            sources: '*',
            criteria: {
                status: null
            },
            limit: 1,
            viewMode: 'small'
        }) }}

        {# Post Date #}
        {{ forms.dateTimeField({
            label: "Post Date"|t('shortlink-manager'),
            id: 'postDate',
            name: 'postDate',
            value: shortLink.postDate ?? shortLink.dateCreated ?? now,
            showTimeZone: false
        }) }}

        {# Expiry Date #}
        {{ forms.dateTimeField({
            label: "Expiry Date"|t('shortlink-manager'),
            id: 'expiryDate',
            name: 'expiryDate',
            value: shortLink.dateExpired ?? null,
            showTimeZone: false
        }) }}

        {% set pendingNewFolderName = craft.app.request.getBodyParam('newFolderName', '') %}
        {% set folderFieldValue = pendingNewFolderName ? '__new__' : (shortLink.folderId ?? '') %}
        {% set folderFieldOptions = [{label: 'None'|t('shortlink-manager'), value: ''}] %}
        {% for value, label in (folderOptions ?? {}) %}
            {% set folderFieldOptions = folderFieldOptions|merge([{label: label, value: value}]) %}
        {% endfor %}
        {% set folderFieldOptions = folderFieldOptions|merge([{label: 'Create new folder...'|t('shortlink-manager'), value: '__new__'}]) %}

        {{ forms.selectField({
            label: "Folder"|t('shortlink-manager'),
            instructions: "Select a folder for this {singularName}."|t('shortlink-manager', {singularName: shortlinkLowerNameHtml}),
            id: 'folderId',
            name: 'folderId',
            value: folderFieldValue,
            options: folderFieldOptions,
        }) }}

        {{ forms.textField({
            instructions: "Create a folder and assign it when this {singularName} is saved."|t('shortlink-manager', {singularName: shortlinkLowerNameHtml}),
            id: 'newFolderName',
            name: 'newFolderName',
            value: pendingNewFolderName,
            placeholder: 'e.g. Campaigns'|t('shortlink-manager'),
            fieldClass: [
                'sidebar-new-folder-field',
                folderFieldValue == '__new__' ? null : 'hidden',
            ],
        }) }}

        {% set tagOptions = [] %}
        {% for tagName in (allTagNames ?? []) %}
            {% set tagOptions = tagOptions|merge([{label: tagName, value: tagName}]) %}
        {% endfor %}
        {{ forms.selectizeField({
            label: "Tags"|t('shortlink-manager'),
            instructions: "Select existing tags or type to add new ones."|t('shortlink-manager'),
            id: 'tags',
            name: 'tags',
            values: shortLink.tagNames ?? [],
            options: tagOptions,
            multi: true,
            selectizeOptions: {
                create: true,
                createOnBlur: true,
                persist: false,
                placeholder: 'Add tags...'|t('shortlink-manager'),
            },
        }) }}
    </div>

    {% if shortLink.id %}
        {% include 'lindemannrock-base/_components/copy-input' with {
            legend: "{pluginName} URL"|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}),
            value: shortLink.getUrl(),
            id: 'shortlink-url',
            copyLabel: 'Copy'|t('shortlink-manager'),
            copiedMessage: 'URL copied to clipboard'|t('shortlink-manager'),
        } only %}
    {% endif %}

    <div class="meta">
        {{ forms.lightswitchField({
            label: "Enabled"|t('shortlink-manager'),
            id: 'enabled',
            name: 'enabled',
            on: shortLink.enabled ?? true,
        }) }}

        {% if plugin.settings.passQueryParams %}
            {{ forms.lightswitchField({
                label: "Pass Query Params"|t('shortlink-manager'),
                instructions: "Pass query parameters from the {pluginName} URL to the destination."|t('shortlink-manager', {pluginName: shortlinkLowerNameHtml}),
                id: 'passQueryParams',
                name: 'passQueryParams',
                on: shortLink.passQueryParams ?? true,
            }) }}
        {% endif %}

        {% if plugin.settings.directRedirect %}
            {{ forms.lightswitchField({
                label: "Direct Redirect"|t('shortlink-manager'),
                instructions: "Server-side redirect without rendering a template."|t('shortlink-manager'),
                id: 'directRedirect',
                name: 'directRedirect',
                on: shortLink.directRedirect ?? true,
            }) }}
        {% endif %}

        {% if canViewAnalytics and plugin.settings.enableAnalytics %}
            {{ forms.lightswitchField({
                label: "Track Analytics"|t('shortlink-manager'),
                id: 'trackAnalytics',
                name: 'trackAnalytics',
                on: shortLink.trackAnalytics ?? true
            }) }}
        {% elseif not plugin.settings.enableAnalytics %}
            {# Hidden field to ensure trackAnalytics is set to false when analytics are disabled #}
            <input type="hidden" name="trackAnalytics" value="0">
        {% endif %}

        {{ forms.lightswitchField({
            label: "Enable QR Code"|t('shortlink-manager'),
            id: 'qrCodeEnabled',
            name: 'qrCodeEnabled',
            on: shortLink.qrCodeEnabled ?? true,
            toggle: 'qr-settings'
        }) }}
    </div>

    {% set hasQrFieldErrors = shortLink.getErrors('qrCodeSize')
        or shortLink.getErrors('qrCodeColor')
        or shortLink.getErrors('qrCodeBgColor')
        or shortLink.getErrors('qrCodeEyeColor') %}
    <fieldset id="qr-settings" class="{{ (not (shortLink.qrCodeEnabled ?? true) and not hasQrFieldErrors) ? 'hidden' }}">
        <legend class="h6">{{ "QR Code"|t('shortlink-manager') }}</legend>

        <div class="meta">
            {% if shortLink.id %}
                <script type="application/json" data-shortlink-qr-preview-config>{{ {
                    generateUrl: actionUrl('shortlink-manager/qr-code/generate', {linkId: shortLink.id}),
                    fields: {
                        size: 'qrCodeSize',
                        format: 'qrCodeFormat',
                        color: 'qrCodeColor',
                        bg: 'qrCodeBgColor',
                        eyeColor: 'qrCodeEyeColor',
                    },
                    defaults: {
                        size: plugin.settings.defaultQrSize ?? 256,
                        format: plugin.settings.defaultQrFormat ?? 'png',
                        color: plugin.settings.defaultQrColor ?? '#000000',
                        bg: plugin.settings.defaultQrBgColor ?? '#FFFFFF',
                        margin: plugin.settings.defaultQrMargin ?? 1,
                        moduleStyle: plugin.settings.qrModuleStyle ?? 'square',
                        eyeStyle: plugin.settings.qrEyeStyle ?? 'square',
                    },
                    preview: {
                        imageSelector: '#qr-preview',
                        size: 150,
                        debounce: 150,
                    },
                    logo: {
                        enabled: plugin.settings.enableQrLogo,
                        defaultLogoId: plugin.settings.defaultQrLogoId,
                        fieldId: 'qrLogoId-field',
                        fieldSelector: '#qrLogoId-field .elements .element',
                    },
                    link: {
                        selector: '#qr-preview-link',
                        baseUrl: plugin.settings.buildPublicUrl((plugin.settings.qrPrefix ?: 'qr') ~ '/' ~ shortLink.slug, shortLink.siteId),
                    },
                }|json_encode|raw }}</script>

                <div class="field">
                    <div class="heading">
                        <label>{{ "Preview"|t('shortlink-manager') }}</label>
                    </div>
                    <div class="input lr-text-center">
                        <a id="qr-preview-link" href="{{ shortLink.getQrCodeUrl() }}" target="_blank" title="{{ 'Click to view QR code image'|t('shortlink-manager') }}">
                            <img id="qr-preview"
                                 src="{{ actionUrl('shortlink-manager/qr-code/generate', { linkId: shortLink.id, size: 150 }) }}"
                                 alt="QR Code Preview"
                                 style="max-width: 150px; height: auto; border: 1px solid #e3e5e8; background: {{ shortLink.qrCodeBgColor ?? '#FFFFFF' }}; cursor: pointer;">
                        </a>
                    </div>
                </div>
            {% endif %}

            {{ forms.textField({
                label: "Size"|t('shortlink-manager'),
                id: 'qrCodeSize',
                name: 'qrCodeSize',
                value: shortLink.qrCodeSize ?? 256,
                type: 'number',
                min: 100,
                max: 1000,
                errors: shortLink.getErrors('qrCodeSize'),
                size: 5,
                fieldClass: ''
            }) }}

            {{ forms.colorField({
                label: "Color"|t('shortlink-manager'),
                id: 'qrCodeColor',
                name: 'qrCodeColor',
                value: shortLink.qrCodeColor ?: plugin.settings.defaultQrColor,
                errors: shortLink.getErrors('qrCodeColor'),
                fieldClass: ''
            }) }}

            {{ forms.colorField({
                label: "Background"|t('shortlink-manager'),
                id: 'qrCodeBgColor',
                name: 'qrCodeBgColor',
                value: shortLink.qrCodeBgColor ?: plugin.settings.defaultQrBgColor,
                errors: shortLink.getErrors('qrCodeBgColor'),
                fieldClass: ''
            }) }}

            {{ forms.colorField({
                label: "Eye Color"|t('shortlink-manager'),
                instructions: "Color for position markers (leave empty to use main color)"|t('shortlink-manager'),
                id: 'qrCodeEyeColor',
                name: 'qrCodeEyeColor',
                value: shortLink.qrCodeEyeColor ?: (plugin.settings.qrEyeColor ?? ''),
                errors: shortLink.getErrors('qrCodeEyeColor'),
                fieldClass: ''
            }) }}

            {{ forms.selectField({
                label: "Format"|t('shortlink-manager'),
                instructions: "Override the default QR code format"|t('shortlink-manager'),
                id: 'qrCodeFormat',
                name: 'qrCodeFormat',
                value: shortLink.qrCodeFormat ?? '',
                options: [
                    { label: 'Default (from settings)'|t('shortlink-manager'), value: '' },
                    { label: 'PNG', value: 'png' },
                    { label: 'SVG', value: 'svg' },
                ],
                fieldClass: ''
            }) }}

            {# QR Logo (only show if logos are enabled in settings) #}
            {% if plugin.settings.enableQrLogo %}
                {% set selectedLogo = null %}
                {% if shortLink.qrLogoId %}
                    {% set selectedLogo = craft.assets.id(shortLink.qrLogoId).one() %}
                {% elseif plugin.settings.defaultQrLogoId %}
                    {% set selectedLogo = craft.assets.id(plugin.settings.defaultQrLogoId).one() %}
                {% endif %}
                {{ forms.elementSelectField({
                    label: "Logo"|t('shortlink-manager'),
                    instructions: shortLink.qrLogoId ? "Override the default QR code logo"|t('shortlink-manager') : "Using default logo from settings (click to override)"|t('shortlink-manager'),
                    id: 'qrLogoId',
                    name: 'qrLogoId',
                    elementType: 'craft\\elements\\Asset',
                    criteria: {
                        kind: ['image']
                    },
                    limit: 1,
                    elements: selectedLogo ? [selectedLogo] : [],
                    fieldClass: ''
                }) }}
            {% endif %}

            {# QR Code Actions #}
            {% if plugin.settings.enableQrDownload and shortLink.id %}
                <div class="field" style="margin-top: 15px;">
                    <div class="heading">
                        <label>{{ "Actions"|t('shortlink-manager') }}</label>
                    </div>
                    <div class="input">
                        <div class="btngroup">
                            <button type="button" class="btn menubtn" data-icon="settings">{{ "QR Code Actions"|t('shortlink-manager') }}</button>
                            <div class="menu">
                                <ul>
                                    <li>
                                        <h6>{{ "Download QR Code"|t('shortlink-manager') }}</h6>
                                        <ul>
                                            <li><a class="download-qr" data-size="256" href="#">{{ "Small (256px)"|t('shortlink-manager') }}</a></li>
                                            <li><a class="download-qr" data-size="512" href="#">{{ "Medium (512px)"|t('shortlink-manager') }}</a></li>
                                            <li><a class="download-qr" data-size="1024" href="#">{{ "Large (1024px)"|t('shortlink-manager') }}</a></li>
                                            <li><a class="download-qr" data-size="2048" href="#">{{ "Extra Large (2048px)"|t('shortlink-manager') }}</a></li>
                                            <li><a class="download-qr" data-size="custom" href="#">{{ "Custom Size..."|t('shortlink-manager') }}</a></li>
                                        </ul>
                                    </li>
                                    <hr>
                                    <li>
                                        <h6>{{ "View QR Code"|t('shortlink-manager') }}</h6>
                                        <ul>
                                            <li>
                                                <a href="{{ shortLink.getQrCodeUrl() }}" target="_blank">
                                                    {{ "QR Code Image"|t('shortlink-manager') }}
                                                </a>
                                            </li>
                                            <li>
                                                <a href="{{ shortLink.getQrCodeDisplayUrl() }}" target="_blank">
                                                    {{ "QR Code Page"|t('shortlink-manager') }}
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                    <hr>
                                    <li><a id="reset-qr-defaults" href="#">{{ "Reset to Defaults"|t('shortlink-manager') }}</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </fieldset>

    {% if shortLink.id %}
        {{ shortLink.getSidebarHtml(true)|raw }}

        <dl class="meta read-only">
            <div class="data">
                <dt class="heading">{{ "ID"|t('shortlink-manager') }}</dt>
                <dd class="value">{{ shortLink.id }}</dd>
            </div>
            <div class="data">
                <dt class="heading">{{ "Status"|t('shortlink-manager') }}</dt>
                <dd class="value">
                    {% set status = shortLink.getStatus() %}
                    {% set statusColorKey = status in ['disabled', 'expired', 'pending'] ? status : 'enabled' %}
                    {% set statusLabel = {
                        enabled: 'Enabled'|t('shortlink-manager'),
                        disabled: 'Disabled'|t('shortlink-manager'),
                        expired: 'Expired'|t('shortlink-manager'),
                        pending: 'Pending'|t('shortlink-manager'),
                    }[statusColorKey] %}
                    {% include 'lindemannrock-base/_components/status-dot' with {
                        value: statusColorKey,
                        colorSet: 'status',
                    } only %}
                    <span>{{ statusLabel }}</span>
                </dd>
            </div>
            <div class="data">
                <dt class="heading">{{ "Interactions"|t('shortlink-manager') }}</dt>
                <dd class="value">{{ shortLink.hits|number_format }}</dd>
            </div>
            <div class="data">
                <dt class="heading">{{ "Created at"|t('shortlink-manager') }}</dt>
                <dd class="value">{{ shortLink.dateCreated|lrDatetime }}</dd>
            </div>
            <div class="data">
                <dt class="heading">{{ "Updated at"|t('shortlink-manager') }}</dt>
                <dd class="value">{{ shortLink.dateUpdated|lrDatetime }}</dd>
            </div>
        </dl>
    {% endif %}
{% endblock %}

{% css %}
    .details .meta > .sidebar-new-folder-field .input {
        width: 100%;
    }

    .details .meta .selectize.multiselect {
        width: 100%;
    }
{% endcss %}
