{#
 # Per-Shortlink Analytics Tab
 #
 # Uses the base plugin's analytics-panel partial for consistent styling.
 #
 # Variables available:
 # - shortLink: The shortlink record
 #}

{# Get analytics data for this shortlink #}
{% set plugin = craft.app.plugins.getPlugin('shortlink-manager') %}
{% set settings = plugin.settings %}
{% set pluginHandle = pluginHandle ?? plugin.id %}
{% set dateRange = craft.app.request.getQueryParam('range') ?? lrDefaultDateRange(pluginHandle) %}
{% set analytics = plugin.analytics.getLinkAnalytics(shortLink.id, dateRange) %}

{% embed 'lindemannrock-base/_partials/analytics-panel' with {
    config: {
        pluginHandle: pluginHandle ?? 'shortlink-manager',
        dateRange: {
            enabled: true,
            current: dateRange,
            param: 'range',
            hash: 'analytics',
        },
        export: {
            action: 'shortlink-manager/analytics/export',
            permission: 'shortLinkManager:exportAnalytics',
            extraParams: {linkId: shortLink.id},
        },
    }
} %}
    {% block content %}
        {% if analytics.totalClicks == 0 %}
            <div class="lr-analytics-empty">
                <p>{{ "No analytics data yet"|t('shortlink-manager') }}</p>
                <p class="light">{{ "Analytics will appear here once your {pluginName} starts receiving clicks."|t('shortlink-manager', {pluginName: shortlinkHelper.lowerDisplayName}) }}</p>
            </div>
        {% else %}
            {# Summary Stats #}
            <div class="lr-unified-cards">
                {% include 'lindemannrock-base/_components/cards/unified-card' with {
                    value: analytics.totalClicks,
                    description: 'Total Interactions'|t('shortlink-manager'),
                    align: 'center',
                } only %}

                {% include 'lindemannrock-base/_components/cards/unified-card' with {
                    value: analytics.uniqueClicks,
                    description: 'Unique Visitors'|t('shortlink-manager'),
                    align: 'center',
                } only %}

                {% include 'lindemannrock-base/_components/cards/unified-card' with {
                    value: analytics.averageClicksPerDay,
                    description: 'Avg. Clicks/Day'|t('shortlink-manager'),
                    align: 'center',
                } only %}
            </div>

            {# Charts Section #}
            <div class="lr-analytics-charts two-columns">
                {# Device Breakdown #}
                <div class="lr-chart-container">
                    <h3>{{ "Device Breakdown"|t('shortlink-manager') }}</h3>
                    {% if analytics.deviceBreakdown|length %}
                        <div style="height: 250px;">
                            <canvas id="link-device-chart"></canvas>
                        </div>
                    {% else %}
                        <p class="light" style="text-align: center; padding: 40px 0;">{{ "Device information not available"|t('shortlink-manager') }}</p>
                    {% endif %}
                </div>

                {# Browser Breakdown #}
                <div class="lr-chart-container">
                    <h3>{{ "Browser Usage"|t('shortlink-manager') }}</h3>
                    {% if analytics.browserBreakdown|length %}
                        <div style="height: 250px;">
                            <canvas id="link-browser-chart"></canvas>
                        </div>
                    {% else %}
                        <p class="light" style="text-align: center; padding: 40px 0;">{{ "Browser information not available"|t('shortlink-manager') }}</p>
                    {% endif %}
                </div>
            </div>

            <div class="lr-analytics-charts two-columns">
                {# OS Breakdown #}
                <div class="lr-chart-container">
                    <h3>{{ "Operating System"|t('shortlink-manager') }}</h3>
                    {% if analytics.osBreakdown|length %}
                        <div style="height: 250px;">
                            <canvas id="link-os-chart"></canvas>
                        </div>
                    {% else %}
                        <p class="light" style="text-align: center; padding: 40px 0;">{{ "OS information not available"|t('shortlink-manager') }}</p>
                    {% endif %}
                </div>
            </div>

            {# Latest Interactions #}
            {% if analytics.recentClicks|length %}
                <div class="lr-chart-container" style="margin-top: 24px;">
                    <h3>{{ "Interactions (Last 20)"|t('shortlink-manager') }}</h3>
                    <div class="lr-table-scroll">
                        <table class="data fullwidth">
                            <thead>
                                <tr>
                                    <th>{{ "Date"|t('shortlink-manager') }}</th>
                                    <th>{{ "Time"|t('shortlink-manager') }}</th>
                                    <th>{{ "Site"|t('app') }}</th>
                                    <th>{{ "Source"|t('shortlink-manager') }}</th>
                                    <th>{{ "Destination"|t('shortlink-manager') }}</th>
                                    <th>{{ "Device"|t('shortlink-manager') }}</th>
                                    <th>{{ "Browser"|t('shortlink-manager') }}</th>
                                    <th>{{ "OS"|t('shortlink-manager') }}</th>
                                    {% if settings.enableGeoDetection %}
                                        <th>{{ "Location"|t('shortlink-manager') }}</th>
                                    {% endif %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for click in analytics.recentClicks %}
                                    <tr>
                                        <td>{{ click.dateCreated|date('short') }}</td>
                                        <td>{{ click.dateCreated|time('short') }}</td>
                                        <td>
                                            {% if click.siteId %}
                                                {% set site = craft.app.sites.getSiteById(click.siteId) %}
                                                {{ site ? site.name : '—' }}
                                            {% else %}
                                                —
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% set source = 'direct' %}
                                            {% if click.metadata %}
                                                {% set metadata = click.metadata|json_decode %}
                                                {% set source = metadata.source ?? 'direct' %}
                                            {% endif %}
                                            {% if source == 'qr' %}
                                                {{ "QR"|t('shortlink-manager') }}
                                            {% else %}
                                                {{ "Direct"|t('shortlink-manager') }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if click.destinationUrl %}
                                                <span title="{{ click.destinationUrl }}">
                                                    {{ click.destinationUrl|length > 40 ? click.destinationUrl|slice(0, 40) ~ '...' : click.destinationUrl }}
                                                </span>
                                            {% else %}
                                                —
                                            {% endif %}
                                        </td>
                                        <td>{{ click.deviceType ? click.deviceType|capitalize : '—' }}</td>
                                        <td>{{ click.browser ?? '—' }}</td>
                                        <td>{{ click.osName ?? '—' }}</td>
                                        {% if settings.enableGeoDetection %}
                                            <td>
                                                {% if click.city and click.country %}
                                                    {{ click.city }}, {{ click.country }}
                                                {% elseif click.country %}
                                                    {{ click.country }}
                                                {% else %}
                                                    —
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    {% endblock %}
{% endembed %}

{# Chart initialization - uses lrCreateChart from AnalyticsAsset #}
{% if analytics.totalClicks > 0 %}
<script>
(function() {
    if (window.lrShortlinkPanelChartsBound) {
        return;
    }
    window.lrShortlinkPanelChartsBound = true;

document.addEventListener('lr:panelChartsReady', function() {
    var chartColors = window.lrChartColors || ['#0d78f2', '#27ae60', '#e74c3c', '#f39c12', '#9b59b6', '#1abc9c'];

    // Device chart
    var deviceData = {{ analytics.deviceBreakdown|json_encode|raw }};
    if (deviceData && Object.keys(deviceData).length > 0) {
        window.lrCreateChart('link-device-chart', 'doughnut', {
            labels: Object.keys(deviceData).map(function(d) { return d.charAt(0).toUpperCase() + d.slice(1); }),
            datasets: [{
                data: Object.values(deviceData),
                backgroundColor: chartColors
            }]
        }, {
            plugins: { legend: { position: 'bottom' } }
        });
    }

    // Browser chart
    var browserData = {{ analytics.browserBreakdown|json_encode|raw }};
    if (browserData && Object.keys(browserData).length > 0) {
        window.lrCreateChart('link-browser-chart', 'bar', {
            labels: Object.keys(browserData),
            datasets: [{
                label: '{{ "Clicks"|t('shortlink-manager')|e('js') }}',
                data: Object.values(browserData),
                backgroundColor: chartColors[0]
            }]
        }, {
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } } },
            plugins: { legend: { display: false } }
        });
    }

    // OS chart
    var osData = {{ analytics.osBreakdown|json_encode|raw }};
    if (osData && Object.keys(osData).length > 0) {
        window.lrCreateChart('link-os-chart', 'doughnut', {
            labels: Object.keys(osData),
            datasets: [{
                data: Object.values(osData),
                backgroundColor: chartColors
            }]
        }, {
            plugins: { legend: { position: 'bottom' } }
        });
    }
});
})();
</script>
{% endif %}
