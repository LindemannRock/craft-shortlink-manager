{% import "_includes/forms" as forms %}

{% set currentSite = craft.app.sites.getSiteById(shortLink.siteId ?? craft.app.sites.currentSite.id) %}
{% set locale = craft.app.i18n.getLocaleById(currentSite.language) %}
{% set textDir = locale.getOrientation() %}

{# DO NOT namespace - these are native element attributes, not custom fields #}

{# Link Type Selection (only for manual/standalone links, not auto/field-managed) #}
{% if shortLink.shortLinkType != 'auto' %}
    {# Show current auto code only for auto-code links; otherwise show a random example #}
    {% if shortLink.id and shortLink.code and shortLink.linkType == 'code' %}
        {% set codeExample = shortLink.code %}
    {% else %}
        {% set codeLength = craft.app.plugins.getPlugin('shortlink-manager').settings.codeLength ?? 8 %}
        {% set chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789' %}
        {% set codeExample = '' %}
        {% for i in 1..codeLength %}
            {% set charArray = chars|split('') %}
            {% set codeExample = codeExample ~ charArray[random(charArray|length - 1)] %}
        {% endfor %}
    {% endif %}
    {{ forms.selectField({
        first: true,
        label: "{singularName} Type"|t('shortlink-manager', {singularName: shortlinkHelper.displayName}),
        instructions: "How the {singularName} code is created"|t('shortlink-manager', {singularName: shortlinkHelper.lowerDisplayName}),
        id: 'linkType',
        name: 'linkType',
        value: shortLink.linkType ?? 'code',
        options: {
            'code': 'Auto-generated Code (e.g., {codeExample})'|t('shortlink-manager', {codeExample: codeExample}),
            'vanity': 'Custom Vanity URL (memorable, e.g., pricing)'|t('shortlink-manager'),
        },
    }) }}
{% else %}
    {# Auto (field-managed) shortlinks - preserve their linkType #}
    <input type="hidden" name="linkType" value="{{ shortLink.linkType ?? 'code' }}">
{% endif %}

{# Slug/Code Field #}
{% if shortLink.shortLinkType == 'auto' %}
    {# Element-linked shortlinks - respect linkType #}
    {% if shortLink.linkType == 'code' %}
        {# Auto-generated - show read-only with regenerate button #}
        <div class="field">
            <div class="heading">
                <label>{{ "Code"|t('shortlink-manager') }}</label>
            </div>
            <div class="input">
                <div class="flex" style="gap: 8px; align-items: center;">
                    <code id="current-code-display" style="font-size: 14px; background: #f3f4f6; padding: 8px 12px; border-radius: 4px;">{{ shortLink.code }}</code>
                    <button type="button" id="regenerate-code-btn" class="btn" data-icon="refresh" aria-label="{{ 'Generate New Code'|t('shortlink-manager') }}" title="{{ 'Generate New Code'|t('shortlink-manager') }}"></button>
                </div>
                <input type="hidden" id="codeAuto" name="code" value="{{ shortLink.code }}">
                <p class="light" style="margin-top: 8px;">{{ "Auto-generated code for linked element"|t('shortlink-manager') }}</p>
            </div>
        </div>
    {% else %}
        {# Vanity - editable #}
        {{ forms.textField({
            label: "Code"|t('shortlink-manager'),
            instructions: "The short code for this link"|t('shortlink-manager'),
            id: 'code',
            name: 'code',
            value: shortLink.code ?? '',
            placeholder: 'my-link',
            required: true,
            errors: shortLink.getErrors('code'),
        }) }}
    {% endif %}
{% else %}
    {# Auto-generated field #}
    <div id="code-field-auto" class="{{ shortLink.linkType == 'vanity' ? 'hidden' : '' }}">
        {% if shortLink.id and shortLink.code and shortLink.linkType == 'code' %}
            <div class="field">
                <div class="heading">
                    <label>{{ "Code"|t('shortlink-manager') }}</label>
                </div>
                <div class="input">
                    <div class="flex" style="gap: 8px; align-items: center;">
                        <code id="current-code-display" style="font-size: 14px; background: #f3f4f6; padding: 8px 12px; border-radius: 4px;">{{ shortLink.code }}</code>
                        <button type="button" id="regenerate-code-btn" class="btn" data-icon="refresh" aria-label="{{ 'Generate New Code'|t('shortlink-manager') }}" title="{{ 'Generate New Code'|t('shortlink-manager') }}"></button>
                    </div>
                    <input type="hidden" id="codeAuto" name="code" value="{{ shortLink.code }}">
                </div>
            </div>
        {% else %}
            <div class="field">
                <div class="heading">
                    <label>{{ "Code"|t('shortlink-manager') }}</label>
                </div>
                <div class="input">
                    <p class="light">{{ "Will be auto-generated when you save (e.g., {example})"|t('shortlink-manager', {example: codeExample}) }}</p>
                    <input type="hidden" id="codeAuto" name="code" value="">
                </div>
            </div>
        {% endif %}
    </div>

    {# Vanity field #}
    <div id="code-field-vanity" class="{{ shortLink.linkType != 'vanity' ? 'hidden' : '' }}">
        {{ forms.textField({
            label: "Code"|t('shortlink-manager'),
            instructions: "Enter a custom memorable code (letters, numbers, hyphens, underscores, spaces)"|t('shortlink-manager'),
            id: 'codeVanity',
            name: 'code',
            value: shortLink.linkType == 'vanity' ? shortLink.code : '',
            placeholder: 'My Promo 2025',
            autofocus: true,
            required: true,
            errors: shortLink.getErrors('code'),
        }) }}
        {% if shortLink.slug and shortLink.code != shortLink.slug %}
            <p class="light" style="margin-top: 4px;">{{ "Slug: {slug}"|t('shortlink-manager', {slug: shortLink.slug}) }}</p>
        {% endif %}
    </div>
{% endif %}

{# Destination URL #}
{% if shortLink.shortLinkType == 'auto' %}
    {# AUTO (field-managed): Read-only destination (auto-synced from element URL) #}
    <div class="field">
        <div class="heading">
            <label>{{ "Destination URL"|t('shortlink-manager') }}</label>
        </div>
        <div class="input">
            {% set linkedElement = shortLink.getLinkedElement() %}
            {% if linkedElement %}
                <p class="light" style="margin-bottom: 8px;">
                    {{ "This {singularName} is managed by a field on:"|t('shortlink-manager', {singularName: shortlinkHelper.lowerDisplayName}) }}
                    <a href="{{ linkedElement.getCpEditUrl() }}" class="go">{{ linkedElement.title }}</a>
                </p>
            {% endif %}
            <input type="text" class="text fullwidth" readonly value="{{ shortLink.destinationUrl ?? '' }}" style="background: #f9fafb;">
            <input type="hidden" name="destinationUrl" value="{{ shortLink.destinationUrl ?? '' }}">
            <p class="light" style="margin-top: 8px;">{{ "Automatically synced from linked element's URL"|t('shortlink-manager') }}</p>
        </div>
    </div>
{% else %}
    {# MANUAL: Show destination type selector #}
    {% set destinationType = shortLink.elementId ?
        (shortLink.elementType ends with 'Entry' ? 'entry' :
         shortLink.elementType ends with 'Category' ? 'category' :
         shortLink.elementType ends with 'Asset' ? 'asset' : 'url')
        : 'url' %}

    {{ forms.selectField({
        label: "Destination Type"|t('shortlink-manager'),
        instructions: "Choose how to set the destination"|t('shortlink-manager'),
        id: 'destinationType',
        name: 'destinationType',
        value: destinationType,
        options: [
            { value: 'url', label: 'Custom URL'|t('shortlink-manager') },
            { value: 'entry', label: 'Entry'|t('shortlink-manager') },
            { value: 'category', label: 'Category'|t('shortlink-manager') },
            { value: 'asset', label: 'Asset'|t('shortlink-manager') },
        ],
    }) }}

    {# Custom URL field #}
    <div id="destination-url-field" class="{{ destinationType != 'url' ? 'hidden' : '' }}">
        {{ forms.textField({
            label: "Destination URL"|t('shortlink-manager'),
            instructions: "Full URL (https://example.com) or path (/page)"|t('shortlink-manager'),
            id: 'destinationUrl',
            name: 'destinationUrl',
            value: destinationType == 'url' ? (shortLink.destinationUrl ?? '') : '',
            type: 'url',
            placeholder: 'https://example.com/your-page',
            required: destinationType == 'url',
            errors: shortLink.getErrors('destinationUrl'),
            translatable: craft.app.sites.getTotalEditableSites() > 1,
        }) }}
    </div>

    {# Get linked element once (may be null) #}
    {% set linkedElement = shortLink.getLinkedElement() %}

    {# Entry picker #}
    <div id="destination-entry-field" class="{{ destinationType != 'entry' ? 'hidden' : '' }}">
        {{ forms.elementSelectField({
            label: "Select Entry"|t('shortlink-manager'),
            instructions: "Choose an entry as the destination"|t('shortlink-manager'),
            id: 'destinationElementEntry',
            name: 'destinationElementEntry',
            elementType: 'craft\\elements\\Entry',
            selectionLabel: "Choose an entry"|t('shortlink-manager'),
            limit: 1,
            elements: (destinationType == 'entry' and linkedElement) ? [linkedElement] : [],
            required: destinationType == 'entry',
            showSiteMenu: true,
            criteria: { status: ['live', 'pending', 'expired'] },
        }) }}
    </div>

    {# Category picker #}
    <div id="destination-category-field" class="{{ destinationType != 'category' ? 'hidden' : '' }}">
        {{ forms.elementSelectField({
            label: "Select Category"|t('shortlink-manager'),
            instructions: "Choose a category as the destination"|t('shortlink-manager'),
            id: 'destinationElementCategory',
            name: 'destinationElementCategory',
            elementType: 'craft\\elements\\Category',
            selectionLabel: "Choose a category"|t('shortlink-manager'),
            limit: 1,
            elements: (destinationType == 'category' and linkedElement) ? [linkedElement] : [],
            required: destinationType == 'category',
            showSiteMenu: true,
        }) }}
    </div>

    {# Asset picker #}
    <div id="destination-asset-field" class="{{ destinationType != 'asset' ? 'hidden' : '' }}">
        {{ forms.elementSelectField({
            label: "Select Asset"|t('shortlink-manager'),
            instructions: "Choose an asset as the destination"|t('shortlink-manager'),
            id: 'destinationElementAsset',
            name: 'destinationElementAsset',
            elementType: 'craft\\elements\\Asset',
            selectionLabel: "Choose an asset"|t('shortlink-manager'),
            limit: 1,
            elements: (destinationType == 'asset' and linkedElement) ? [linkedElement] : [],
            required: destinationType == 'asset',
            showSiteMenu: true,
        }) }}
    </div>

    {# JavaScript to toggle destination fields #}
    {% js %}
        (function() {
            const destinationTypeSelect = document.getElementById('destinationType');
            if (!destinationTypeSelect) return;

            function toggleDestinationFields() {
                const type = destinationTypeSelect.value;
                document.getElementById('destination-url-field').classList.toggle('hidden', type !== 'url');
                document.getElementById('destination-entry-field').classList.toggle('hidden', type !== 'entry');
                document.getElementById('destination-category-field').classList.toggle('hidden', type !== 'category');
                document.getElementById('destination-asset-field').classList.toggle('hidden', type !== 'asset');

                // Update required attributes
                const urlInput = document.getElementById('destinationUrl');
                if (urlInput) {
                    urlInput.required = (type === 'url');
                }
            }

            destinationTypeSelect.addEventListener('change', toggleDestinationFields);
        })();
    {% endjs %}
{% endif %}

{# HTTP Status Code #}
<div class="field">
    <div class="heading">
        <label for="httpCode">{{ 'HTTP Status Code'|t('shortlink-manager') }}
            <span class="required" aria-label="Required"></span>
        </label>
        <div class="instructions">
            <p>{{ 'The HTTP status code to use for the redirect'|t('shortlink-manager') }}</p>
        </div>
    </div>
    <div class="input">
        <div class="select">
            <select id="httpCode" name="httpCode" required>
                <option value="301" {% if (shortLink.httpCode ?? 301) == 301 %}selected{% endif %}>{{ '301 - Moved Permanently'|t('shortlink-manager') }}</option>
                <option value="302" {% if (shortLink.httpCode ?? 301) == 302 %}selected{% endif %}>{{ '302 - Found (Temporary)'|t('shortlink-manager') }}</option>
                <option value="307" {% if (shortLink.httpCode ?? 301) == 307 %}selected{% endif %}>{{ '307 - Temporary Redirect'|t('shortlink-manager') }}</option>
                <option value="308" {% if (shortLink.httpCode ?? 301) == 308 %}selected{% endif %}>{{ '308 - Permanent Redirect'|t('shortlink-manager') }}</option>
            </select>
        </div>
    </div>
    <p id="httpCodeTip" class="notice has-icon" style="margin-top: 10px;">
        <span class="icon" aria-hidden="true"></span>
        <span class="visually-hidden">Tip:</span>
        <span id="httpCodeTipText"></span>
    </p>
</div>

{# Expired Redirect URL #}
{{ forms.textField({
    label: "Expired Redirect URL"|t('shortlink-manager'),
    instructions: "Where to redirect when this {pluginName} expires (optional)"|t('shortlink-manager', {pluginName: shortlinkHelper.lowerDisplayName}),
    id: 'expiredRedirectUrl',
    name: 'expiredRedirectUrl',
    value: shortLink.expiredRedirectUrl ?? '',
    type: 'url',
    placeholder: 'https://example.com/expired',
    errors: shortLink.getErrors('expiredRedirectUrl'),
    translatable: craft.app.sites.getTotalEditableSites() > 1,
}) }}

{{ forms.textareaField({
    label: "Expired Message"|t('shortlink-manager'),
    instructions: "Custom message shown when this {pluginName} expires (leave empty to use default from settings)"|t('shortlink-manager', {pluginName: shortlinkHelper.lowerDisplayName}),
    id: 'expiredMessage',
    name: 'expiredMessage',
    value: shortLink.expiredMessage ?? '',
    rows: 2,
    placeholder: plugin.settings.expiredMessage,
    errors: shortLink.getErrors('expiredMessage'),
    translatable: craft.app.sites.getTotalEditableSites() > 1,
    inputAttributes: {
        dir: textDir
    },
}) }}
