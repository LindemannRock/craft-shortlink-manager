<script>
	(function() {
		var goUrl = {{ goUrl|json_encode|raw }};
		var shortlinkCode = {{ shortlinkCode|json_encode|raw }};

		{% if skipDebugRedirect %}
		var urlParams = new URLSearchParams(window.location.search);

		if (urlParams.get('debug') === '1') {
			console.log('🐛 DEBUG MODE ENABLED - Redirect is disabled for testing');
			console.log('➡️ Go URL:', goUrl);
			console.log('🔗 Shortlink Code:', shortlinkCode);

			return;
		}
		{% endif %}

		setTimeout(function() {
			if (typeof window.pushShortLinkEvent === 'function') {
				window.pushShortLinkEvent('redirect');
			}
			var navigate = function() {
				window.location.replace(goUrl);
			};
			if (window.shortLinkAutoTrackingQueued === true) {
				// Give asynchronous tracking a bounded grace period, not a delivery guarantee.
				setTimeout(navigate, 2000);
			} else {
				navigate();
			}
		}, 100);
	})();
</script>
