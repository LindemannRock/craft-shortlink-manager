{% extends "shortlink-manager/_layouts/cp" %}
{% set title = "Import/Export"|t('shortlink-manager') %}
{% set fullPageForm = false %}
{% set selectedSubnavItem = 'import-export' %}

{% set crumbs = [
    { label: shortlinkHelper.fullName|t('shortlink-manager'), url: url('shortlink-manager') },
    { label: 'Import/Export'|t('shortlink-manager'), url: url('shortlink-manager/import-export') }
] %}
{% set canImportExport = canImport or canExport %}
{% set tabs = {} %}
{% if canImportExport %}
    {% set tabs = tabs|merge({
        importExport: {
            label: 'Import/Export'|t('shortlink-manager'),
            url: '#import-export',
        },
    }) %}
{% endif %}
{% if canViewHistory %}
    {% set tabs = tabs|merge({
        importHistory: {
            label: 'Import History'|t('shortlink-manager'),
            url: '#import-history',
        },
    }) %}
{% endif %}
{% if not canImportExport and canViewHistory %}
    {% set selectedTab = 'importHistory' %}
{% endif %}

{% set maxRows = importLimits.maxRows ?? 4000 %}
{% set maxBytes = importLimits.maxBytes ?? 5242880 %}
{% set maxSize = craft.app.formatter.asShortSize(maxBytes, 2) %}

{% block content %}
    <div id="import-export">
        <h2 style="margin-top: 0;">{{ "Export Shortlinks"|t('shortlink-manager') }}</h2>

        {% if canExport %}
            <p>{{ "Download all your current shortlinks as a CSV file for backup or migration to another site."|t('shortlink-manager') }}</p>
            <form method="post" action="{{ actionUrl('shortlink-manager/import-export/export') }}" style="margin-bottom: 50px;">
                {{ csrfInput() }}
                <button type="submit" class="btn secondary">{{ "Export All Shortlinks as CSV"|t('shortlink-manager') }}</button>
            </form>
        {% else %}
            <p class="light">{{ "You do not have permission to export shortlinks."|t('shortlink-manager') }}</p>
        {% endif %}

        <hr>

        <h2>{{ "Import Shortlinks"|t('shortlink-manager') }}</h2>

        {% set csvFormatTip %}
            <h4>{{ "CSV Format"|t('shortlink-manager') }}</h4>
            <p><strong>{{ "Required columns:"|t('shortlink-manager') }}</strong> code</p>
            <p><strong>{{ "Rules:"|t('shortlink-manager') }}</strong> destinationUrl is required for manual links; elementId is required for field-managed links (shortLinkType=auto).</p>
            <p><strong>{{ "Optional columns:"|t('shortlink-manager') }}</strong> shortLinkType, linkType, destinationUrl, elementId, elementType, httpCode, enabled, siteId, siteHandle, trackAnalytics, passQueryParams, directRedirect, qrCodeEnabled, qrCodeSize, qrCodeColor, qrCodeBgColor, qrCodeEyeColor, qrCodeFormat, qrLogoId, postDate, dateExpired</p>
            <pre style="background: #f3f4f6; padding: 8px; border-radius: 4px; font-size: 12px;">code,shortLinkType,destinationUrl,elementId,elementType,linkType,httpCode,enabled,trackAnalytics,passQueryParams,directRedirect,qrCodeEnabled,qrCodeSize,qrCodeColor,qrCodeBgColor,qrCodeEyeColor,qrCodeFormat,postDate,dateExpired
summer-sale,manual,https://example.com/sale,,,vanity,301,1,1,0,0,1,512,#FF7300,#FFF700,#0400FF,png,2025-12-01 21:31:00,2026-12-31 23:59:59
promo-entry,auto,,123,craft\elements\Entry,code,301,1,1,,,1,256,,,,,2025-12-01 21:31:00,</pre>
        {% endset %}

        {% if canImport %}
            {% include 'lindemannrock-base/_partials/import-csv' with {
                action: actionUrl('shortlink-manager/import-export/upload'),
                formId: 'uploadForm',
                title: 'Import from CSV'|t('shortlink-manager'),
                description: "Import shortlinks from CSV. You'll map columns and preview before importing."|t('shortlink-manager'),
                csvFormatTip: csvFormatTip,
                fileLabel: 'CSV File'|t('shortlink-manager'),
                fileInstructions: 'Select a CSV file to import shortlinks'|t('shortlink-manager'),
                delimiterLabel: 'CSV Delimiter'|t('shortlink-manager'),
                delimiterInstructions: 'Character used to separate values in your CSV (auto-detect is default)'|t('shortlink-manager'),
                delimiterValue: 'auto',
                delimiterOptions: {
                    'auto': 'Auto (detect)'|t('shortlink-manager'),
                    ',': 'Comma (,)'|t('shortlink-manager'),
                    ';': 'Semicolon (;)'|t('shortlink-manager'),
                    "\t": 'Tab'|t('shortlink-manager'),
                    '|': 'Pipe (|)'|t('shortlink-manager'),
                },
                showBackupToggle: false,
                infoBoxMessage: 'The maximum file size is {size} and the import is limited to {rows} rows per file.'|t('shortlink-manager', {
                    size: maxSize,
                    rows: maxRows|number_format
                }),
                submitLabel: 'Upload & Map Columns'|t('shortlink-manager'),
            } %}
        {% else %}
            <p class="light">{{ "You do not have permission to import shortlinks."|t('shortlink-manager') }}</p>
        {% endif %}
    </div>

    {% if canViewHistory %}
        {% include 'lindemannrock-base/_partials/import-history' with {
            sectionId: 'import-history',
            title: 'Import History'|t('shortlink-manager'),
            importHistory: importHistory,
            canClearHistory: currentUser.can('shortLinkManager:clearImportHistory'),
            clearButtonId: 'clear-logs-btn',
            clearLabel: 'Clear history'|t('shortlink-manager'),
            emptyMessage: 'No import history yet.'|t('shortlink-manager'),
            translationCategory: 'shortlink-manager',
        } only %}
    {% endif %}

    {% include 'lindemannrock-base/_components/plugin-credit' %}
{% endblock %}

{% js %}
    {% include 'lindemannrock-base/_partials/import-history-js' with {
        tabStorageKey: 'showHistoryTab',
        tabSelector: 'a[href="#import-history"]',
        clearButtonId: 'clear-logs-btn',
        clearAction: 'shortlink-manager/import-export/clear-logs',
        confirmMessage: 'Are you sure you want to clear all import logs? This action cannot be undone.'|t('shortlink-manager'),
        clearErrorMessage: 'Failed to clear history.'|t('shortlink-manager'),
    } only %}
{% endjs %}
