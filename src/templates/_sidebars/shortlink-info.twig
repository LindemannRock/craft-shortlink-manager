{% import "_includes/forms" as forms %}
{% set plugin = craft.app.plugins.getPlugin('shortlink-manager') %}

{# ShortLink URL #}
{% include 'lindemannrock-base/_components/copy-input' with {
	legend: "{pluginName} URL"|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}),
	value: shortLink.getUrl(),
	id: 'shortlink-url-sidebar',
	copyLabel: 'Copy'|t('shortlink-manager'),
	copiedMessage: 'Copied to clipboard!'|t('shortlink-manager'),
} only %}

{# Status Section - Consolidated #}
<fieldset>
	<legend class='h6'>{{ "{pluginName} Status"|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}</legend>
	<div class='meta'>
		{% set status = shortLink.getStatus() %}
		{% set statusColorKey = status in ['disabled', 'expired', 'pending'] ? status : 'enabled' %}
		{% set statusLabel = {
			enabled: 'Enabled'|t('shortlink-manager'),
			disabled: 'Disabled'|t('shortlink-manager'),
			expired: 'Expired'|t('shortlink-manager'),
			pending: 'Pending'|t('shortlink-manager'),
		}[statusColorKey] %}
		<div class='field'>
			<div class='heading'>
				<label>{{ "Status"|t('shortlink-manager') }}</label>
			</div>
			<div class='input'>
				{% include 'lindemannrock-base/_components/status-dot' with {
					value: statusColorKey,
					colorSet: 'status',
				} only %}
				<span>{{ statusLabel }}</span>
			</div>
		</div>

		{% if status not in ['disabled', 'expired'] %}
			{% if plugin.settings.passQueryParams %}
				<div class='field'>
					<div class='heading'>
						<label>{{ "Query Params"|t('shortlink-manager') }}</label>
					</div>
					<div class='input'>
						{% set passQueryParamsEnabled = shortLink.passQueryParams ?? true %}
						{% include 'lindemannrock-base/_components/status-dot' with {
							value: passQueryParamsEnabled ? 'enabled' : 'disabled',
							colorSet: 'status',
						} only %}
						<span>{{ passQueryParamsEnabled ? 'Enabled'|t('shortlink-manager') : 'Disabled'|t('shortlink-manager') }}</span>
					</div>
				</div>
			{% endif %}

			{% if plugin.settings.directRedirect %}
				<div class='field'>
					<div class='heading'>
						<label>{{ "Direct Redirect"|t('shortlink-manager') }}</label>
					</div>
					<div class='input'>
						{% set directRedirectEnabled = shortLink.directRedirect ?? true %}
						{% include 'lindemannrock-base/_components/status-dot' with {
							value: directRedirectEnabled ? 'enabled' : 'disabled',
							colorSet: 'status',
						} only %}
						<span>{{ directRedirectEnabled ? 'Enabled'|t('shortlink-manager') : 'Disabled'|t('shortlink-manager') }}</span>
					</div>
				</div>
			{% endif %}

			{% if plugin.settings.enableAnalytics %}
				<div class='field'>
					<div class='heading'>
						<label>{{ "Analytics"|t('shortlink-manager') }}</label>
					</div>
					<div class='input'>
						{% include 'lindemannrock-base/_components/status-dot' with {
							value: shortLink.trackAnalytics ? 'enabled' : 'disabled',
							colorSet: 'status',
						} only %}
						<span>{{ shortLink.trackAnalytics ? 'Enabled'|t('shortlink-manager') : 'Disabled'|t('shortlink-manager') }}</span>
					</div>
				</div>
			{% endif %}

			<div class='field'>
				<div class='heading'>
					<label>{{ "QR Code"|t('shortlink-manager') }}</label>
				</div>
				<div class='input'>
					{% include 'lindemannrock-base/_components/status-dot' with {
						value: shortLink.qrCodeEnabled ? 'enabled' : 'disabled',
						colorSet: 'status',
					} only %}
					<span>{{ shortLink.qrCodeEnabled ? 'Enabled'|t('shortlink-manager') : 'Disabled'|t('shortlink-manager') }}</span>
				</div>
			</div>
		{% endif %}

		<div class='field'>
			<div class='heading'>
				<label>{{ "Interactions"|t('shortlink-manager') }}</label>
			</div>
			<div class='input'>
				{{ shortLink.hits | number_format }}
			</div>
		</div>

		<div class='field'>
			<div class='heading'>
				<label>{{ "Actions"|t('shortlink-manager') }}</label>
			</div>
			<div class='input'>
				<a href='{{ cpUrl('shortlink-manager/shortlinks/' ~ shortLink.id) }}' class='btn fullwidth'>
					<span class='icon'>{{ svg('@appicons/edit.svg') }}</span>
					{{ "Edit {pluginName}"|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}
				</a>
			</div>
		</div>
	</div>
</fieldset>

{# QR Code Details - Only shown if shortlink is active and QR is enabled #}
{% if shortLink.qrCodeEnabled and status not in ['disabled', 'expired'] %}
	<fieldset>
		<legend class='h6'>{{ "{pluginName} QR Code"|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}</legend>
		<div class='meta'>
			<div class='field'>
				<div class='heading'>
					<label>{{ "Preview"|t('shortlink-manager') }}</label>
				</div>
				<div class='input lr-text-center'>
					<a href='{{ shortLink.getQrCodeUrl() }}' target='_blank' title='{{ 'Click to view QR code image'|t('shortlink-manager') }}'>
						<img
							src='{{ actionUrl('shortlink-manager/qr-code/generate', { linkId: shortLink.id, size: 150 }) }}'
							alt='QR Code Preview'
							style='max-width: 150px; height: auto; border: 1px solid #e3e5e8; background: {{ shortLink.qrCodeBgColor ?? '#FFFFFF' }}; cursor: pointer;'
						>
					</a>
				</div>
			</div>

			<div class='field'>
				<div class='heading'>
					<label>{{ "Size"|t('shortlink-manager') }}</label>
				</div>
				<div class='input'>
					<span>{{ shortLink.qrCodeSize ?? 256 }}</span>
				</div>
			</div>

			<div class='field'>
				<div class='heading'>
					<label>{{ "Color"|t('shortlink-manager') }}</label>
				</div>
				<div class='input'>
					<div style='display: flex; align-items: center; gap: 8px;'>
						<div style='width: 24px; height: 24px; border-radius: 4px; border: 1px solid #e3e5e8; background: {{ shortLink.qrCodeColor ?: plugin.settings.defaultQrColor }};'></div>
						<code style='font-size: 12px;'>{{ shortLink.qrCodeColor ?: plugin.settings.defaultQrColor }}</code>
					</div>
				</div>
			</div>

			<div class='field'>
				<div class='heading'>
					<label>{{ "Background"|t('shortlink-manager') }}</label>
				</div>
				<div class='input'>
					<div style='display: flex; align-items: center; gap: 8px;'>
						<div style='width: 24px; height: 24px; border-radius: 4px; border: 1px solid #e3e5e8; background: {{ shortLink.qrCodeBgColor ?: plugin.settings.defaultQrBgColor }};'></div>
						<code style='font-size: 12px;'>{{ shortLink.qrCodeBgColor ?: plugin.settings.defaultQrBgColor }}</code>
					</div>
				</div>
			</div>

			<div class='field'>
				<div class='heading'>
					<label>{{ "Eye Color"|t('shortlink-manager') }}</label>
				</div>
				<div class='input'>
					{% if shortLink.qrCodeEyeColor or plugin.settings.qrEyeColor %}
						<div style='display: flex; align-items: center; gap: 8px;'>
							<div style='width: 24px; height: 24px; border-radius: 4px; border: 1px solid #e3e5e8; background: {{ shortLink.qrCodeEyeColor ?: (plugin.settings.qrEyeColor ?? '') }};'></div>
							<code style='font-size: 12px;'>{{ shortLink.qrCodeEyeColor ?: (plugin.settings.qrEyeColor ?? '') }}</code>
						</div>
					{% else %}
						<span class='light'>{{ "Using main color"|t('shortlink-manager') }}</span>
					{% endif %}
				</div>
			</div>

			<div class='field'>
				<div class='heading'>
					<label>{{ "Format"|t('shortlink-manager') }}</label>
				</div>
				<div class='input'>
					<span>{{ shortLink.qrCodeFormat ? shortLink.qrCodeFormat|upper : 'Default (from settings)'|t('shortlink-manager') }}</span>
				</div>
			</div>

			{# QR Code Actions #}
			{% if plugin.settings.enableQrDownload %}
				<div class='field' style='margin-top: 15px;'>
					<div class='heading'>
						<label>{{ "Actions"|t('shortlink-manager') }}</label>
					</div>
					<div class='input'>
						<div class='btngroup'>
							<button type='button' class='btn menubtn' data-icon='settings'>{{ "QR Code Actions"|t('shortlink-manager') }}</button>
							<div class='menu'>
								<ul>
									<li>
										<h6>{{ "Download QR Code"|t('shortlink-manager') }}</h6>
										<ul>
											<li>
												<a href='{{ shortLink.getQrCodeUrl({ format: 'png', size: 256, download: 1 }) }}'>{{ "Small (256px)"|t('shortlink-manager') }}</a>
											</li>
											<li>
												<a href='{{ shortLink.getQrCodeUrl({ format: 'png', size: 512, download: 1 }) }}'>{{ "Medium (512px)"|t('shortlink-manager') }}</a>
											</li>
											<li>
												<a href='{{ shortLink.getQrCodeUrl({ format: 'png', size: 1024, download: 1 }) }}'>{{ "Large (1024px)"|t('shortlink-manager') }}</a>
											</li>
											<li>
												<a href='{{ shortLink.getQrCodeUrl({ format: 'png', size: 2048, download: 1 }) }}'>{{ "Extra Large (2048px)"|t('shortlink-manager') }}</a>
											</li>
										</ul>
									</li>
									<hr>
									<li>
										<h6>{{ "View QR Code"|t('shortlink-manager') }}</h6>
										<ul>
											<li>
												<a href='{{ shortLink.getQrCodeUrl() }}' target='_blank'>
													{{ "QR Code Image"|t('shortlink-manager') }}
												</a>
											</li>
											<li>
												<a href='{{ shortLink.getQrCodeDisplayUrl() }}' target='_blank'>
													{{ "QR Code Page"|t('shortlink-manager') }}
												</a>
											</li>
										</ul>
									</li>
									<hr>
									<li>
										<a href='{{ cpUrl('shortlink-manager/shortlinks/' ~ shortLink.id) }}'>
											{{ "Edit {pluginName}"|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}
										</a>
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			{% endif %}
		</div>
	</fieldset>
{% endif %}
