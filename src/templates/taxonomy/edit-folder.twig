{% extends "shortlink-manager/_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = 'Edit Folder'|t('shortlink-manager') %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'taxonomy' %}

{% set crumbs = [
    { label: shortlinkHelper.fullName, url: url('shortlink-manager') },
    { label: 'Folders & Tags'|t('shortlink-manager'), url: url('shortlink-manager/taxonomy', { view: 'folders' }) },
    { label: folder.name },
] %}

{% block actionButton %}
    <div class="btngroup submit">
        <button type="submit" class="btn submit">{{ "Save"|t('app') }}</button>
    </div>
    <a class="btn" href="{{ url('shortlink-manager/taxonomy', { view: 'folders' }) }}">{{ "Cancel"|t('app') }}</a>
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="shortlink-manager/taxonomy/save-folder">
    {{ redirectInput(url('shortlink-manager/taxonomy', { view: 'folders' })) }}
    <input type="hidden" name="folderId" value="{{ folder.id }}">

    {{ forms.textField({
        first: true,
        label: 'Folder Name'|t('shortlink-manager'),
        id: 'folderName',
        name: 'name',
        value: folder.name,
        required: true,
    }) }}
{% endblock %}
