{% extends "shortlink-manager/_layouts/cp" %}

{% set title = isNew ? 'New Folder'|t('shortlink-manager') : 'Edit Folder'|t('shortlink-manager') %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'taxonomy' %}

{% set crumbs = [
    { label: shortlinkHelper.fullName, url: url('shortlink-manager') },
    { label: 'Folders & Tags'|t('shortlink-manager'), url: url('shortlink-manager/taxonomy', { view: 'folders' }) },
    { label: isNew ? 'New Folder'|t('shortlink-manager') : folder.name },
] %}

{% block actionButton %}
    <div class="btngroup submit">
        <button type="submit" class="btn submit">{{ "Save"|t('shortlink-manager') }}</button>
    </div>
    <a class="btn" href="{{ url('shortlink-manager/taxonomy', { view: 'folders' }) }}">{{ "Cancel"|t('shortlink-manager') }}</a>
{% endblock %}

{% block content %}
    {% include 'shortlink-manager/taxonomy/_edit-form' with {
        formAction: 'shortlink-manager/taxonomy/save-folder',
        redirectUrl: url('shortlink-manager/taxonomy', { view: 'folders' }),
        idInputName: 'folderId',
        taxonomyItem: folder,
        fieldId: 'folderName',
        fieldLabel: 'Folder Name'|t('shortlink-manager'),
    } only %}
{% endblock %}
