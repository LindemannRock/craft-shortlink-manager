{% extends 'lindemannrock-base/_layouts/cp-table' %}

{# Filters arrive pre-validated from the controller. Don't re-validate or
   default them here — the controller has already snapped off-list values
   back to defaults. #}

{% set setupIncompleteSummary = include('shortlink-manager/_partials/setup-incomplete-summary', {
    selectedSubnavItem: 'taxonomy',
}, false)|trim %}
{% set errorSummary = (setupIncompleteSummary ~ (errorSummary ?? ''))|trim %}

{% set tableConfig = {
    plugin: {
        handle: 'shortlink-manager',
        name: shortlinkHelper.fullName,
    },
    page: {
        title: 'Folders & Tags'|t('shortlink-manager'),
        subnav: 'taxonomy',
        crumbs: [
            { label: shortlinkHelper.fullName, url: url('shortlink-manager') },
            { label: 'Folders & Tags'|t('shortlink-manager') },
        ],
    },
    sidebarMenu: {
        label: 'Taxonomy'|t('shortlink-manager'),
        items: {
            folders: { label: 'Folders'|t('shortlink-manager'), url: url('shortlink-manager/taxonomy', { view: 'folders' }) },
            tags: { label: 'Tags'|t('shortlink-manager'), url: url('shortlink-manager/taxonomy', { view: 'tags' }) },
        },
        selected: currentView,
    },
    search: {
        placeholder: currentView == 'tags' ? 'Search tags...'|t('shortlink-manager') : 'Search folders...'|t('shortlink-manager'),
        value: search,
    },
    sort: {
        field: sort,
        direction: dir,
    },
    table: {
        columns: [
            { key: 'name', label: 'Name'|t('shortlink-manager'), sortable: true },
            { key: 'usageCount', label: 'Used by'|t('shortlink-manager'), sortable: true, hideable: true },
        ],
        items: items,
        emptyMessage: currentView == 'tags'
            ? 'No tags found.'|t('shortlink-manager')
            : 'No folders found.'|t('shortlink-manager'),
    },
    pagination: {
        page: page,
        limit: limit,
        totalCount: totalCount,
        itemLabel: {
            singular: currentView == 'tags' ? 'tag'|t('shortlink-manager') : 'folder'|t('shortlink-manager'),
            plural: currentView == 'tags' ? 'tags'|t('shortlink-manager') : 'folders'|t('shortlink-manager'),
        },
    },
    checkboxes: canDelete,
    rowActions: true,
    newButton: canCreate ? (currentView == 'folders'
        ? {
            url: url('shortlink-manager/taxonomy/folders/new'),
            label: 'New Folder'|t('shortlink-manager'),
        }
        : {
            url: url('shortlink-manager/taxonomy/tags/new'),
            label: 'New Tag'|t('shortlink-manager'),
        }) : null,
} %}

{% block tableRow %}
    <td data-column="name" class="{{ currentView == 'folders' ? 'nowrap' : '' }}">
        {% if currentView == 'folders' %}
            <a href="{{ url('shortlink-manager/taxonomy/folders/' ~ item.id) }}">{{ item.name }}</a>
        {% else %}
            <a href="{{ url('shortlink-manager/taxonomy/tags/' ~ item.id) }}">{{ item.name }}</a>
        {% endif %}
    </td>
    <td data-column="usageCount">{{ item.usageCount }}</td>
{% endblock %}

{% block rowActions %}
    {% if currentView == 'folders' %}
        {% include 'lindemannrock-base/_components/row-actions' with {
            item: item,
            actions: {
                type: 'menu',
                icon: 'settings',
                title: 'Actions'|t('shortlink-manager'),
                items: [
                    canEdit ? {
                        label: 'Edit'|t('shortlink-manager'),
                        url: url('shortlink-manager/taxonomy/folders/' ~ item.id),
                    } : null,
                    (canEdit and canDelete) ? {type: 'divider'} : null,
                    canDelete ? {
                        label: 'Delete'|t('shortlink-manager'),
                        class: 'error',
                        jsAction: 'delete-folder',
                        title: item.usageCount > 0 ? 'This also unassigns the folder from linked shortlinks.'|t('shortlink-manager') : null,
                    } : null,
                ]|filter(v => v is not null),
            },
        } only %}
    {% else %}
        {% include 'lindemannrock-base/_components/row-actions' with {
            item: item,
            actions: {
                type: 'menu',
                icon: 'settings',
                title: 'Actions'|t('shortlink-manager'),
                items: [
                    canEdit ? {
                        label: 'Edit'|t('shortlink-manager'),
                        url: url('shortlink-manager/taxonomy/tags/' ~ item.id),
                    } : null,
                    (canEdit and canDelete) ? {type: 'divider'} : null,
                    canDelete ? {
                        label: 'Delete'|t('shortlink-manager'),
                        class: 'error',
                        jsAction: 'delete-tag',
                    } : null,
                ]|filter(v => v is not null),
            },
        } only %}
    {% endif %}
{% endblock %}

{% block bulkActions %}
    {% if canDelete %}
        {% include 'lindemannrock-base/_components/bulk-actions-menu' with {
            label: 'Actions'|t('shortlink-manager'),
            countId: 'lr-bulk-actions-count',
            items: [
                {id: 'lr-bulk-delete-btn', label: 'Delete'|t('shortlink-manager'), class: 'error'},
            ],
        } only %}
    {% endif %}
{% endblock %}

{% block scripts %}
<script>
(function() {
    if (typeof Craft === 'undefined') return;

    const currentView = {{ currentView|json_encode|raw }};
    const tableBody = document.getElementById('lr-table-body');
    const emptyMessage = currentView === 'tags'
        ? {{ 'No tags found.'|t('shortlink-manager')|json_encode|raw }}
        : {{ 'No folders found.'|t('shortlink-manager')|json_encode|raw }};

    // Pre-translated strings: keep |t() in Twig (so they're translatable)
    // and emit as JSON-encoded JS literals via |json_encode|raw — avoids
    // the |e('js') trap (produces \uXXXX garbage when re-quoted).
    const T = {
        deleteFolderConfirm: {{ 'Delete this folder?'|t('shortlink-manager')|json_encode|raw }},
        deleteTagConfirm: {{ 'Delete this tag?'|t('shortlink-manager')|json_encode|raw }},
        folderDeleted: {{ 'Folder deleted.'|t('shortlink-manager')|json_encode|raw }},
        tagDeleted: {{ 'Tag deleted.'|t('shortlink-manager')|json_encode|raw }},
        deleteFolderFailed: {{ 'Could not delete folder.'|t('shortlink-manager')|json_encode|raw }},
        deleteTagFailed: {{ 'Could not delete tag.'|t('shortlink-manager')|json_encode|raw }},
        bulkDeleteFoldersConfirmSingular: {{ 'Delete {count} folder? This will also unassign it from linked shortlinks.'|t('shortlink-manager')|json_encode|raw }},
        bulkDeleteFoldersConfirmPlural: {{ 'Delete {count} folders? This will also unassign them from linked shortlinks.'|t('shortlink-manager')|json_encode|raw }},
        bulkDeleteTagsConfirmSingular: {{ 'Delete {count} tag?'|t('shortlink-manager')|json_encode|raw }},
        bulkDeleteTagsConfirmPlural: {{ 'Delete {count} tags?'|t('shortlink-manager')|json_encode|raw }},
        bulkDeleteFoldersFailed: {{ 'Could not delete folders.'|t('shortlink-manager')|json_encode|raw }},
        bulkDeleteTagsFailed: {{ 'Could not delete tags.'|t('shortlink-manager')|json_encode|raw }},
        deleteCompleted: {{ 'Delete completed.'|t('shortlink-manager')|json_encode|raw }},
    };

    function removeDeletedRow(id) {
        if (!tableBody) return;

        const row = tableBody.querySelector('.lr-data-row[data-id="' + CSS.escape(String(id)) + '"]');
        if (!row) return;

        row.remove();

        if (tableBody.querySelector('.lr-data-row')) return;

        const emptyRow = document.createElement('tr');
        emptyRow.className = 'lr-empty-row';

        const cell = document.createElement('td');
        cell.colSpan = document.querySelectorAll('#lr-data-table thead th').length || 1;
        cell.style.textAlign = 'center';
        cell.style.padding = '2em';
        cell.textContent = emptyMessage;

        emptyRow.appendChild(cell);
        tableBody.appendChild(emptyRow);
    }

    function removeDeletedRows(ids) {
        ids.forEach(removeDeletedRow);
    }

    function selectedIds() {
        return window.lrTableSelection ? window.lrTableSelection.getSelectedIds() : [];
    }

    function sendDeleteRequest(endpoint, key, id, successMessage, failureMessage) {
        const data = {};
        data[key] = id;

        Craft.sendActionRequest('POST', endpoint, {data: data})
            .then(function(response) {
                const message = response.data && response.data.message ? response.data.message : successMessage;
                Craft.cp.displayNotice(message);
                removeDeletedRow(id);
            })
            .catch(function(response) {
                const message = response && response.response && response.response.data && response.response.data.message
                    ? response.response.data.message
                    : failureMessage;
                Craft.cp.displayError(message);
            });
    }

    function sendBulkDeleteRequest(endpoint, key, ids, failureMessage) {
        if (!ids.length) return;

        const data = {};
        data[key] = ids;

        Craft.sendActionRequest('POST', endpoint, {data: data})
            .then(function(response) {
                const message = response.data && response.data.message ? response.data.message : T.deleteCompleted;
                Craft.cp.displayNotice(message);
                removeDeletedRows(ids);
                window.lrTableSelection?.clear();
            })
            .catch(function(response) {
                const message = response && response.response && response.response.data && response.response.data.message
                    ? response.response.data.message
                    : failureMessage;
                Craft.cp.displayError(message);
            });
    }

    // ---------------------------------------------------------------------
    // Row actions: delegated click handler, scoped by anchor + action name.
    // Confirmation lives in this handler (single source of truth); the
    // row-action items do not set `confirm:` to avoid double-prompts.
    // ---------------------------------------------------------------------
    document.addEventListener('click', function(e) {
        const trigger = e.target.closest('a[data-action]');
        if (!trigger) return;

        const action = trigger.dataset.action;
        if (action !== 'delete-folder' && action !== 'delete-tag') return;

        const itemId = trigger.dataset.id;
        if (!itemId) return;
        e.preventDefault();

        if (action === 'delete-folder') {
            if (!confirm(T.deleteFolderConfirm)) return;
            sendDeleteRequest(
                'shortlink-manager/taxonomy/delete-folder',
                'folderId',
                itemId,
                T.folderDeleted,
                T.deleteFolderFailed
            );
            return;
        }

        if (!confirm(T.deleteTagConfirm)) return;
        sendDeleteRequest(
            'shortlink-manager/taxonomy/delete-tag',
            'tagId',
            itemId,
            T.tagDeleted,
            T.deleteTagFailed
        );
    });

    document.getElementById('lr-bulk-delete-btn')?.addEventListener('click', function() {
        const ids = selectedIds();
        if (!ids.length) return;

        if (currentView === 'folders') {
            const confirmTemplate = ids.length === 1 ? T.bulkDeleteFoldersConfirmSingular : T.bulkDeleteFoldersConfirmPlural;
            if (!confirm(confirmTemplate.replace('{count}', ids.length))) return;
            sendBulkDeleteRequest(
                'shortlink-manager/taxonomy/bulk-delete-folders',
                'folderIds',
                ids,
                T.bulkDeleteFoldersFailed
            );
            return;
        }

        const confirmTemplate = ids.length === 1 ? T.bulkDeleteTagsConfirmSingular : T.bulkDeleteTagsConfirmPlural;
        if (!confirm(confirmTemplate.replace('{count}', ids.length))) return;
        sendBulkDeleteRequest(
            'shortlink-manager/taxonomy/bulk-delete-tags',
            'tagIds',
            ids,
            T.bulkDeleteTagsFailed
        );
    });
})();
</script>
{% endblock %}
