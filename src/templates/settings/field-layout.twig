{% extends "shortlink-manager/_layouts/settings" %}
{% import '_includes/forms.twig' as forms %}

{% set title = 'Field Layout'|t('shortlink-manager') %}
{% set selectedSettingsItem = 'field-layout' %}
{% set fullPageForm = not (readOnly ?? false) %}
{% if readOnly ?? false %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}

    <div class="field">
        <p class="readable">
            {{ 'Add custom fields to {singularName} elements. Any fields you add here will appear in the {singularName} edit screen.'|t('shortlink-manager', {singularName: shortlinkHelper.displayName}) }}
        </p>
    </div>

    {% if not (readOnly ?? false) %}
        {{ actionInput('shortlink-manager/settings/save-field-layout') }}
        {{ redirectInput('shortlink-manager/settings/field-layout') }}
    {% endif %}

    {% if fieldLayout is defined and fieldLayout %}
        {{ forms.fieldLayoutDesignerField({
            fieldLayout: fieldLayout,
            disabled: readOnly ?? false,
        }) }}
    {% else %}
        <p class="notice">{{ 'No field layout available.'|t('shortlink-manager') }}</p>
    {% endif %}

    {% include 'lindemannrock-base/_components/plugin-credit' %}

{% endblock %}
