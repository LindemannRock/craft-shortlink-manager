{% extends "shortlink-manager/_layouts/settings" %}
{% set title = "Interface Settings"|t('shortlink-manager') %}
{% set fullPageForm = true %}
{% set selectedSettingsItem = 'interface' %}

{% set crumbs = [
    {
        label: shortlinkHelper.fullName|t('shortlink-manager'),
        url: url('shortlink-manager'),
    },
    {
        label: 'Settings'|t('shortlink-manager'),
        url: url('shortlink-manager/settings'),
    },
    {
        label: 'Interface'|t('shortlink-manager'),
        url: url('shortlink-manager/settings/interface'),
    },
] %}

{% import "_includes/forms" as forms %}

{% block content %}

	{{ actionInput('shortlink-manager/settings/save') }}
	{{ redirectInput('shortlink-manager/settings/interface') }}
	{{ hiddenInput('section', 'interface') }}

		<h2 class="first">{{ "Interface Settings"|t('shortlink-manager') }}</h2>

		{% include 'lindemannrock-base/_partials/field-items-per-page' with {
            settings: settings,
            pluginHandle: 'shortlink-manager',
        } only %}

		<hr>

		{% include 'lindemannrock-base/_partials/cascade-base-overrides' with {
            settings: settings,
            pluginHandle: 'shortlink-manager',
            sections: {
                dateFormat: {},
                dateRange: {},
                exports: {},
            },
        } only %}

	{% include 'lindemannrock-base/_components/plugin-credit.twig' %}
{% endblock %}
