{% extends "shortlink-manager/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{% set title = "General Settings"|t('shortlink-manager') %}
{% set fullPageForm = true %}
{% set selectedSettingsItem = 'general' %}

{% set crumbs = [
    {
        label: shortlinkHelper.fullName|t('shortlink-manager'),
        url: url('shortlink-manager'),
    },
    {
        label: 'Settings'|t('shortlink-manager'),
        url: url('shortlink-manager/settings'),
    },
] %}

{% block actionButton %}
	<div class="btngroup">
		<input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
	</div>
{% endblock %}

{% block content %}

	{% set smartLinksPlugin = craft.app.plugins.getPlugin('smartlink-manager') ?? craft.app.plugins.getPlugin('smart-links') %}
	{% set smartLinksInstalled = craft.app.plugins.isPluginInstalled('smartlink-manager') or craft.app.plugins.isPluginInstalled('smart-links') %}

	<form method="post" accept-charset="UTF-8">
		<input type="hidden" name="action" value="shortlink-manager/settings/save">
		{{ csrfInput() }}
		{{ redirectInput('shortlink-manager/settings/general') }}
		{{ hiddenInput('section', 'general') }}

		<h2 style="margin-top: 0px;">{{ "General Settings"|t('shortlink-manager') }}</h2>

		{{ forms.textField({
        label: "Plugin Name"|t('shortlink-manager'),
        instructions: "The name of the plugin as it appears in the Control Panel menu"|t('shortlink-manager'),
        id: 'pluginName',
        name: 'settings[pluginName]',
        value: settings.pluginName,
        required: true,
        disabled: settings.isOverriddenByConfig('pluginName'),
        warning: settings.isOverriddenByConfig('pluginName') ?
            "This is being overridden by the <code>pluginName</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
    }) }}

		<hr>

		<h2>{{ "Site Settings"|t('shortlink-manager') }}</h2>

		{# Site selection checkboxes #}
		{% set siteOptions = [] %}
		{% for site in craft.app.sites.getAllSites() %}
			{% set siteOptions = siteOptions|merge([{
				label: site.name,
				value: site.id
			}]) %}
		{% endfor %}

		{{ forms.checkboxGroupField({
			label: "Enabled Sites"|t('shortlink-manager'),
			instructions: "Select which sites {pluginName} should be enabled for. Leave empty to enable for all sites."|t('shortlink-manager', {pluginName: shortlinkHelper.fullName}),
			id: 'enabledSites',
			name: 'settings[enabledSites]',
			options: siteOptions,
			values: settings.enabledSites ?? [],
			disabled: settings.isOverriddenByConfig('enabledSites'),
			warning: settings.isOverriddenByConfig('enabledSites') ?
				"This is being overridden by the <code>enabledSites</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
		}) }}

		<hr>

		<h2>{{ "URL Settings"|t('shortlink-manager') }}</h2>

        {% set rmPlugin = craft.app.plugins.getPlugin('redirect-manager') %}
        {% set rmActive = rmPlugin and craft.app.plugins.isPluginEnabled('redirect-manager') %}
        {% set rmPluginName = rmPlugin ? (rmPlugin.settings.pluginName ?? 'Redirect Manager') : 'Redirect Manager' %}
        {% set smartLinkPluginForWarning = craft.app.plugins.getPlugin('smartlink-manager') ?? craft.app.plugins.getPlugin('smart-links') %}
        {% set smartLinkEnabledForWarning = (craft.app.plugins.isPluginEnabled('smartlink-manager') or craft.app.plugins.isPluginEnabled('smart-links')) and smartLinkPluginForWarning %}
        {% set smartLinkUsePrefix = smartLinkEnabledForWarning ? (smartLinkPluginForWarning.settings.usePrefix ?? true) : true %}
        {% set smartLinkNameForWarning = smartLinkEnabledForWarning ? (smartLinkPluginForWarning.settings.pluginName ?? smartLinkPluginForWarning.name ?? 'SmartLink Manager') : 'SmartLink Manager' %}
        {% set currentUsePrefix = settings.usePrefix ?? true %}
        {% set sameHostCollision = false %}
        {% set possibleHostCollision = false %}

        {% if (not currentUsePrefix) and (not smartLinkUsePrefix) %}
            {% set currentHosts = [] %}
            {% set otherHosts = [] %}
            {% set currentUnknownHost = false %}
            {% set otherUnknownHost = false %}

            {% set shortlinkUrlSource = settings.shortlinkBaseUrl ?? '' %}
            {% if shortlinkUrlSource|trim is not empty %}
                {% if '://' in shortlinkUrlSource %}
                    {% set shortlinkHost = shortlinkUrlSource|replace({'https://': '', 'http://': ''})|split('/')|first|split(':')|first|lower %}
                    {% if shortlinkHost %}
                        {% set currentHosts = currentHosts|merge([shortlinkHost]) %}
                    {% endif %}
                {% else %}
                    {% set currentUnknownHost = true %}
                {% endif %}
            {% else %}
                {% for site in craft.app.sites.getAllSites() %}
                    {% if site.baseUrl and '://' in site.baseUrl %}
                        {% set siteHost = site.baseUrl|replace({'https://': '', 'http://': ''})|split('/')|first|split(':')|first|lower %}
                        {% if siteHost and siteHost not in currentHosts %}
                            {% set currentHosts = currentHosts|merge([siteHost]) %}
                        {% endif %}
                    {% else %}
                        {% set currentUnknownHost = true %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% set smartlinkSettingsForWarning = smartLinkEnabledForWarning ? smartLinkPluginForWarning.settings : null %}
            {% if smartlinkSettingsForWarning %}
                {% set smartlinkUrlSource = smartlinkSettingsForWarning.smartlinkBaseUrl ?? '' %}
                {% if smartlinkUrlSource|trim is not empty %}
                    {% if '://' in smartlinkUrlSource %}
                        {% set smartlinkHost = smartlinkUrlSource|replace({'https://': '', 'http://': ''})|split('/')|first|split(':')|first|lower %}
                        {% if smartlinkHost %}
                            {% set otherHosts = otherHosts|merge([smartlinkHost]) %}
                        {% endif %}
                    {% else %}
                        {% set otherUnknownHost = true %}
                    {% endif %}
                {% else %}
                    {% for site in craft.app.sites.getAllSites() %}
                        {% if site.baseUrl and '://' in site.baseUrl %}
                            {% set siteHost = site.baseUrl|replace({'https://': '', 'http://': ''})|split('/')|first|split(':')|first|lower %}
                            {% if siteHost and siteHost not in otherHosts %}
                                {% set otherHosts = otherHosts|merge([siteHost]) %}
                            {% endif %}
                        {% else %}
                            {% set otherUnknownHost = true %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% endif %}

            {% for host in currentHosts %}
                {% if host in otherHosts %}
                    {% set sameHostCollision = true %}
                {% endif %}
            {% endfor %}

            {% if (not sameHostCollision) and (currentUnknownHost or otherUnknownHost) %}
                {% set possibleHostCollision = true %}
            {% endif %}
        {% endif %}

        {% set slugTip = rmActive
            ? "Changing will break existing URLs. To migrate, create wildcard redirect in {rmPluginName}: Source '/old/*' → Destination '/new/$1' (Match Type: Wildcard)"|t('shortlink-manager', {rmPluginName: rmPluginName})
            : "Changing the URL prefix will break all existing {pluginName}. Only change this before creating your first {singularName}."|t('shortlink-manager', {pluginName: shortlinkHelper.pluralLowerDisplayName, singularName: shortlinkHelper.lowerDisplayName})
        %}

        {{ forms.lightswitchField({
            label: "Use URL Prefix"|t('shortlink-manager'),
            instructions: "Enable to generate {singularName} URLs as /{prefix}/{code}. Disable to generate root URLs as /{code}."|t('shortlink-manager', {singularName: shortlinkHelper.lowerDisplayName, prefix: settings.slugPrefix ?: 's', code: 'abc123'}),
            id: 'usePrefix',
            name: 'settings[usePrefix]',
            on: settings.usePrefix ?? true,
            toggle: 'slug-prefix-field-wrapper',
            disabled: settings.isOverriddenByConfig('usePrefix'),
            warning: settings.isOverriddenByConfig('usePrefix') ?
                "This is being overridden by the <code>usePrefix</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
        }) }}

        {% if sameHostCollision %}
            {% include 'lindemannrock-base/_components/info-box' with {
                type: 'warning',
                margin: 'both',
                message: "Both {shortName} and {smartName} are set to root URLs (no prefix) and share at least one host. Redirect routes can collide (e.g., <code>/code</code>), and QR routes can also collide when both plugins use the same QR prefix (e.g., <code>/qr/code</code>)."|t('shortlink-manager', {shortName: shortlinkHelper.fullName, smartName: smartLinkNameForWarning})|raw
            } %}
        {% elseif possibleHostCollision %}
            {% include 'lindemannrock-base/_components/info-box' with {
                type: 'warning',
                margin: 'both',
                message: "Both {shortName} and {smartName} are set to root URLs (no prefix). Host overlap could not be fully resolved from current settings/config, so redirect route collisions are possible. QR routes may also collide if both plugins use the same QR prefix."|t('shortlink-manager', {shortName: shortlinkHelper.fullName, smartName: smartLinkNameForWarning})
            } %}
        {% endif %}

        <div id="slug-prefix-field-wrapper" class="{{ not currentUsePrefix ? 'hidden' : '' }}">
            {{ forms.textField({
                label: "{singularName} URL Prefix"|t('shortlink-manager', {singularName: shortlinkHelper.displayName}),
                instructions: "The URL prefix for {pluginName} (e.g., 's' creates /s/abc123)"|t('shortlink-manager', {pluginName: shortlinkHelper.pluralLowerDisplayName}),
                id: 'slugPrefix',
                name: 'settings[slugPrefix]',
                value: settings.slugPrefix,
                errors: settings.getErrors('slugPrefix'),
                placeholder: 's',
                required: true,
                tip: slugTip,
                disabled: settings.isOverriddenByConfig('slugPrefix'),
                warning: settings.isOverriddenByConfig('slugPrefix') ?
                    "This is being overridden by the <code>slugPrefix</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
            }) }}
        </div>

        {% if not currentUsePrefix %}
            {% include 'lindemannrock-base/_components/info-box' with {
                type: 'info',
                message: "URL Prefix is disabled. {singularName} URLs will be generated as root paths like <code>/abc123</code>."|t('shortlink-manager', {singularName: shortlinkHelper.displayName})|raw
            } %}
        {% endif %}

        {% set qrTip = rmActive
            ? "Changing will break existing QR URLs. To migrate, create wildcard redirect in {rmPluginName}: Source '/old/*' → Destination '/new/$1' (Match Type: Wildcard). Supports standalone (e.g., 'qr') or nested (e.g., 's/qr') patterns."|t('shortlink-manager', {rmPluginName: rmPluginName})
            : "Supports standalone (e.g., 'qr') or nested (e.g., 's/qr') patterns. Checked for conflicts with Smart Links."|t('shortlink-manager')
        %}

		{# Calculate smart default for qrPrefix if empty #}
        {% set qrPrefixValue = settings.qrPrefix %}
        {% set nestedDefault = (settings.slugPrefix ?: 's') ~ '/qr' %}
        {% if not currentUsePrefix %}
            {% if qrPrefixValue is empty %}
                {% set qrPrefixValue = 'qr' %}
            {% endif %}
		{% elseif qrPrefixValue is empty %}
			{# Try nested pattern first (safer and more organized) #}
			{% set smartQrDefault = nestedDefault %}

			{% if smartLinksInstalled and smartLinksPlugin %}
				{% set smartLinksSettings = smartLinksPlugin.getSettings() %}
				{% set conflictingPrefixes = [
					smartLinksSettings.slugPrefix ?? 'go',
					smartLinksSettings.qrPrefix ?? 'qr',
				] %}

				{# Check if nested pattern conflicts with Smart Links #}
				{% if nestedDefault in conflictingPrefixes %}
					{# Try standalone alternatives #}
					{% set found = false %}
					{% for candidate in ['qr', 'sqr', 'q', 's-qr'] %}
						{% if not found and candidate not in conflictingPrefixes and candidate != settings.slugPrefix %}
							{% set smartQrDefault = candidate %}
							{% set found = true %}
						{% endif %}
					{% endfor %}
				{% endif %}
			{% endif %}

			{% set qrPrefixValue = smartQrDefault %}
		{% endif %}

		{{ forms.textField({
            label: "QR Code URL Prefix"|t('shortlink-manager'),
            instructions: "The URL prefix for QR code pages (e.g., 'qr' creates /qr/abc123/view or 's/qr' creates /s/qr/abc123/view)"|t('shortlink-manager'),
            id: 'qrPrefix',
            name: 'settings[qrPrefix]',
            value: qrPrefixValue,
            errors: settings.getErrors('qrPrefix'),
            required: true,
            placeholder: currentUsePrefix ? nestedDefault : 'qr',
            tip: qrTip,
            disabled: settings.isOverriddenByConfig('qrPrefix'),
            warning: settings.isOverriddenByConfig('qrPrefix') ?
                "This is being overridden by the <code>qrPrefix</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
        }) }}

        {{ forms.autosuggestField({
            label: "{singularName} Base URL"|t('shortlink-manager', {singularName: shortlinkHelper.displayName}),
            instructions: "Base URL for {singularName} and QR code URLs. For multisite, you can use tokens: {siteHandle}, {siteId}, {siteUid} (e.g., https://short.example.com/{siteHandle}). Leave empty to use each site's base URL."|t('shortlink-manager', {singularName: shortlinkHelper.lowerDisplayName}),
            id: 'shortlinkBaseUrl',
            name: 'settings[shortlinkBaseUrl]',
            value: settings.shortlinkBaseUrl ?? '',
            errors: settings.getErrors('shortlinkBaseUrl'),
            placeholder: 'https://short.example.com',
            suggestEnvVars: true,
            disabled: settings.isOverriddenByConfig('shortlinkBaseUrl'),
            warning: settings.isOverriddenByConfig('shortlinkBaseUrl') ?
                "This is being overridden by the <code>shortlinkBaseUrl</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
        }) }}

        {% set hasMultipleSites = craft.app.sites.getAllSites()|length > 1 %}
        {% set hasSiteToken = '{siteHandle}' in (settings.shortlinkBaseUrl ?? '') or '{siteId}' in (settings.shortlinkBaseUrl ?? '') or '{siteUid}' in (settings.shortlinkBaseUrl ?? '') %}
        {% if hasMultipleSites and (settings.shortlinkBaseUrl ?? '')|trim is not empty and not hasSiteToken %}
            {% include 'lindemannrock-base/_components/info-box' with {
                type: 'warning',
                message: "Multisite detected: <code>{singularName} Base URL</code> is set without a site token. Generated URLs may resolve to only one site. Use a tokenized URL like <code>https://short.example.com/{siteHandle}</code> to preserve site-specific routing."|t('shortlink-manager', {singularName: shortlinkHelper.displayName, siteHandle: '{siteHandle}'})|raw
            } %}
        {% endif %}

		{{ forms.textField({
        label: "Code Length"|t('shortlink-manager'),
        instructions: "Length of generated {singularName} codes (min: 4, max: 32)"|t('shortlink-manager', {singularName: shortlinkHelper.lowerDisplayName}),
        id: 'codeLength',
        name: 'settings[codeLength]',
        value: settings.codeLength,
        type: 'number',
        min: 4,
        max: 32,
        required: true,
        disabled: settings.isOverriddenByConfig('codeLength'),
        warning: settings.isOverriddenByConfig('codeLength') ?
            "This is being overridden by the <code>codeLength</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
        errors: settings.getErrors('codeLength')
    }) }}

		<hr>

		<h2>{{ "Template Settings"|t('shortlink-manager') }}</h2>

		{% include 'lindemannrock-base/_components/info-box' with {
			type: 'info',
			message: "These templates must exist in your site's <code>templates/</code> folder. Copy the reference templates from <code>vendor/lindemannrock/craft-shortlink-manager/src/templates/</code> to <code>templates/shortlink-manager/</code> and customize as needed."|t('shortlink-manager')
		} %}

		{{ forms.autosuggestField({
            label: "Redirect Template"|t('shortlink-manager'),
            instructions: "Template path in your templates/ folder. Leave empty to use the default path."|t('shortlink-manager'),
            id: 'redirectTemplate',
            name: 'settings[redirectTemplate]',
            value: settings.redirectTemplate ?? '',
            placeholder: 'shortlink-manager/redirect',
            suggestEnvVars: true,
            disabled: settings.isOverriddenByConfig('redirectTemplate'),
            warning: settings.isOverriddenByConfig('redirectTemplate') ?
                "This is being overridden by the <code>redirectTemplate</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
            errors: settings.getErrors('redirectTemplate')
        }) }}
        <p class="light" style="margin-top: -12px; margin-bottom: 24px;">
            {{ "Required: copy <code>vendor/lindemannrock/craft-shortlink-manager/src/templates/redirect.twig</code> to <code>templates/shortlink-manager/redirect.twig</code>"|t('shortlink-manager')|raw }}
        </p>
        {% if settings.directRedirect %}
            {% include 'lindemannrock-base/_components/info-box' with {
                type: 'warning',
                message: "Note: This template is not used when Direct Redirect is enabled (Settings → Behavior). Links using direct redirect skip the template entirely."|t('shortlink-manager')
            } %}
        {% endif %}

		{{ forms.autosuggestField({
            label: "Expired Template"|t('shortlink-manager'),
            instructions: "Template path in your templates/ folder. Leave empty to use the default path."|t('shortlink-manager'),
            id: 'expiredTemplate',
            name: 'settings[expiredTemplate]',
            value: settings.expiredTemplate ?? '',
            placeholder: 'shortlink-manager/expired',
            suggestEnvVars: true,
            disabled: settings.isOverriddenByConfig('expiredTemplate'),
            warning: settings.isOverriddenByConfig('expiredTemplate') ?
                "This is being overridden by the <code>expiredTemplate</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
            errors: settings.getErrors('expiredTemplate')
        }) }}
        <p class="light" style="margin-top: -12px; margin-bottom: 24px;">
            {{ "Required: copy <code>vendor/lindemannrock/craft-shortlink-manager/src/templates/expired.twig</code> to <code>templates/shortlink-manager/expired.twig</code>"|t('shortlink-manager')|raw }}
        </p>

		{{ forms.autosuggestField({
            label: "QR Code Template"|t('shortlink-manager'),
            instructions: "Template path in your templates/ folder. Leave empty to use the default path."|t('shortlink-manager'),
            id: 'qrTemplate',
            name: 'settings[qrTemplate]',
            value: settings.qrTemplate ?? '',
            placeholder: 'shortlink-manager/qr',
            suggestEnvVars: true,
            disabled: settings.isOverriddenByConfig('qrTemplate'),
            warning: settings.isOverriddenByConfig('qrTemplate') ?
                "This is being overridden by the <code>qrTemplate</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
            errors: settings.getErrors('qrTemplate')
        }) }}
        <p class="light" style="margin-top: -12px; margin-bottom: 24px;">
            {{ "Required: copy <code>vendor/lindemannrock/craft-shortlink-manager/src/templates/qr.twig</code> to <code>templates/shortlink-manager/qr.twig</code>"|t('shortlink-manager')|raw }}
        </p>

		{{ forms.textareaField({
            label: "Default Expired Message"|t('shortlink-manager'),
            id: 'expiredMessage',
            name: 'settings[expiredMessage]',
            value: settings.expiredMessage,
            rows: 3,
            instructions: "Message shown on the expired page when no custom redirect URL is set"|t('shortlink-manager'),
            disabled: settings.isOverriddenByConfig('expiredMessage'),
            warning: settings.isOverriddenByConfig('expiredMessage') ?
                "This is being overridden by the <code>expiredMessage</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
        }) }}

		<hr>

		<h2>{{ "Logging Settings"|t('shortlink-manager') }}</h2>

		{% set logOptions = [
        {value: 'error', label: 'Error (Critical errors only)'|t('shortlink-manager')},
        {value: 'warning', label: 'Warning (Errors and warnings)'|t('shortlink-manager')},
        {value: 'info', label: 'Info (General information)'|t('shortlink-manager')},
    ] %}

		{% if craft.app.config.general.devMode %}
			{% set logOptions = logOptions|merge([
            {value: 'debug', label: 'Debug (Detailed debugging)'|t('shortlink-manager')}
        ]) %}
		{% endif %}

		{{ forms.selectField({
        label: 'Log Level'|t('shortlink-manager'),
        instructions: 'Choose what types of messages to log. Debug level requires devMode to be enabled.'|t('shortlink-manager'),
        id: 'logLevel',
        name: 'settings[logLevel]',
        value: settings.logLevel,
        options: logOptions,
        disabled: settings.isOverriddenByConfig('logLevel'),
        warning: settings.isOverriddenByConfig('logLevel') ?
            "This is being overridden by the <code>logLevel</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
    }) }}

	</form>

	{% include 'lindemannrock-base/_components/plugin-credit.twig' %}
{% endblock %}
