{% extends "shortlink-manager/_layouts/settings" %}
{% set title = "Integrations Settings"|t('shortlink-manager') %}
{% set fullPageForm = true %}
{% set selectedSettingsItem = 'integrations' %}

{% set crumbs = [
    {
        label: shortlinkHelper.fullName|t('shortlink-manager'),
        url: url('shortlink-manager'),
    },
    {
        label: 'Settings'|t('shortlink-manager'),
        url: url('shortlink-manager/settings'),
    },
    {
        label: 'Integrations'|t('shortlink-manager'),
        url: url('shortlink-manager/settings/integrations'),
    },
] %}

{% import "_includes/forms" as forms %}

{% block content %}

    {{ actionInput('shortlink-manager/settings/save') }}
    {{ redirectInput('shortlink-manager/settings/integrations') }}
    {{ hiddenInput('section', 'integrations') }}
    {% set shortlinkPluralLowerNameHtml = shortlinkHelper.pluralLowerDisplayName|e %}

        <h2 class="first">{{ "Third-Party Integrations"|t('shortlink-manager') }}</h2>

        <div class="field">
            <p class="light">{{ "Integrate {pluginName} with third-party analytics and tracking services to push click events to Google Tag Manager, Google Analytics, and other platforms."|t('shortlink-manager', { pluginName: shortlinkHelper.fullName }) }}</p>
        </div>

        {% set integrationStatuses = craft.app.plugins.getPlugin('shortlink-manager').integration.getAllIntegrationStatuses() %}

        {# SEOmatic Integration #}
        {% set seomaticStatus = integrationStatuses.seomatic ?? null %}
        {% set seomaticInstalled = lrPluginInstalled('seomatic') %}
        {% set seomaticAvailable = lrPluginEnabled('seomatic') %}
        {% set seomaticPluginName = lrPluginName('seomatic', 'SEOmatic') %}
        {% set seomaticPluginNameHtml = seomaticPluginName|e %}
        {% set seomaticIntegrationEnabled = 'seomatic' in (settings.enabledIntegrations ?? []) %}

        {% embed 'lindemannrock-base/_partials/integration-card' with {
            title: "{pluginName} Integration"|t('shortlink-manager', { pluginName: seomaticPluginName }),
            description: "Push {pluginName} events to Google Tag Manager and analytics platforms for tracking redirects and QR code scans."|t('shortlink-manager', {pluginName: shortlinkHelper.lowerDisplayName}),
            available: seomaticAvailable,
            installed: seomaticInstalled,
            installUrl: 'https://plugins.craftcms.com/seomatic',
            statusLabels: {
                active: 'Installed & Active'|t('shortlink-manager'),
                disabled: 'Installed but Disabled'|t('shortlink-manager'),
                notInstalled: 'Not Installed'|t('shortlink-manager'),
                install: 'Install Plugin'|t('shortlink-manager'),
            },
            toggleId: 'enableSeomaticIntegration',
            toggleName: 'enableSeomaticIntegration',
            toggleOn: seomaticIntegrationEnabled,
            toggleDisabled: not seomaticAvailable or settings.isOverriddenByConfig('enabledIntegrations'),
            bodyId: 'seomatic-settings',
            bodyVisible: seomaticIntegrationEnabled,
        } %}
            {% block body %}
                {% import "_includes/forms" as forms %}

                {% if settings.directRedirect %}
                    {% include 'lindemannrock-base/_components/info-box' with {
                        type: 'warning',
                        variant: 'colored',
                        margin: 'bottom',
                        message: "Direct Redirect is enabled globally in <a href=\"{url}\" class=\"go\">Behavior Settings</a>. SEOmatic client-side tracking (GTM/GA events) will not fire for redirected {pluginName} because the template is skipped. Server-side analytics and hit counting only run when the request reaches Craft/PHP. If every hit must be tracked, configure cache bypass rules for your shortlink routes and clear existing browser, CDN, or static caches before retesting redirect-mode changes."|t('shortlink-manager', {pluginName: shortlinkPluralLowerNameHtml, url: url('shortlink-manager/settings/behavior')|e('html_attr')})
                    } %}
                {% endif %}

                {% if settings.isOverriddenByConfig('enabledIntegrations') %}
                    {% include 'lindemannrock-base/_components/config-override-warning' with {
                        message: "This is being overridden by the <code>enabledIntegrations</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')
                    } only %}
                {% endif %}

                {# Configured GTM and GA4 scripts; event forwarding depends on the tag configuration. #}
                {% set dataLayerScripts = ['googleTagManager', 'gtag'] %}
                {% set hasDataLayerScripts = false %}
                {% for handle in dataLayerScripts %}
                    {% if seomaticStatus.scripts[handle] is defined %}
                        {% set hasDataLayerScripts = true %}
                    {% endif %}
                {% endfor %}

                {% if hasDataLayerScripts %}
                    <div class="lr-integration-scripts">
                        <div class="lr-integration-scripts__heading">
                            <strong>{{ "Active Tracking Scripts"|t('shortlink-manager') }}</strong>
                            <span class="light">{{ "Tracking scripts enabled in {pluginName}"|t('shortlink-manager', { pluginName: seomaticPluginName }) }}</span>
                        </div>
                        {% for handle in dataLayerScripts %}
                            {% if seomaticStatus.scripts[handle] is defined %}
                                {% set script = seomaticStatus.scripts[handle] %}
                                <div class="lr-integration-scripts__item">
                                    <div class="lr-integration-scripts__name">
                                        {% include 'lindemannrock-base/_components/status-dot' with {
                                            status: 'enabled',
                                            size: 8,
                                        } only %}
                                        <strong>{{ script.name }}</strong>
                                    </div>
                                    {% if script.sites is defined and script.sites is not empty %}
                                        <div class="lr-integration-scripts__sites">
                                            {% for site in script.sites %}
                                                <div class="lr-integration-scripts__site">
                                                    <strong>{{ site.name }}</strong>
                                                    {% if site.id is defined and site.id %}
                                                        <code>{{ site.id }}</code>
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>

                {% else %}
                    {% include 'lindemannrock-base/_components/info-box' with {
                        type: 'warning',
                        variant: 'colored',
                        margin: 'bottom',
                        message: '<strong>' ~ "Note"|t('shortlink-manager') ~ ':</strong> ' ~ "No tracking scripts are currently configured in {pluginName}. Configure Google Tag Manager and its event triggers and tags to send these events to your analytics platform."|t('shortlink-manager', { pluginName: seomaticPluginNameHtml })
                    } %}
                {% endif %}

                {# Configuration Section #}
                <div class="lr-integration-section">
                    <h4 class="lr-integration-section__title">{{ "Configuration"|t('shortlink-manager') }}</h4>

                    {# Event Type Selection - Lightswitch Toggles #}
                    {% set eventPrefix = settings.seomaticEventPrefix ?? 'short_links' %}
                    {% set trackingEvents = settings.seomaticTrackingEvents ?? ['redirect', 'qr_scan'] %}
                    {% set isOverridden = settings.isOverriddenByConfig('seomaticTrackingEvents') %}

                    <div class="field">
                        <div class="heading">
                            <label>{{ "Tracking Events"|t('shortlink-manager') }}</label>
                            <div class="instructions">
                                <p>{{ "Select which events to add to the page’s data layer."|t('shortlink-manager') }}</p>
                            </div>
                        </div>

                        {% if isOverridden %}
                            {% include 'lindemannrock-base/_components/config-override-warning' with {
                                message: "This is being overridden by the <code>seomaticTrackingEvents</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')
                            } only %}
                        {% endif %}

                        <div class="lr-option-rows">
                            {# Redirects #}
                            <div class="lr-option-row">
                                <div class="lr-flex-none">
                                    {{ forms.lightswitchField({
                                        label: false,
                                        id: 'seomaticTrackingEvents-redirect',
                                        name: 'settings[seomaticTrackingEvents][]',
                                        value: 'redirect',
                                        on: 'redirect' in trackingEvents,
                                        disabled: isOverridden,
                                    }) }}
                                </div>
                                <div>
                                    <strong>{{ "Redirects"|t('shortlink-manager') }}</strong>
                                    <span class="light lr-option-row__desc">{{ "When the intermediate page starts redirecting"|t('shortlink-manager') }}</span>
                                    <div class="light lr-option-row__desc">{{ "Event name:"|t('shortlink-manager') }} <code>{{ eventPrefix ~ '_redirect' }}</code></div>
                                </div>
                            </div>

                            {# QR Code Scans #}
                            <div class="lr-option-row">
                                <div class="lr-flex-none">
                                    {{ forms.lightswitchField({
                                        label: false,
                                        id: 'seomaticTrackingEvents-qr_scan',
                                        name: 'settings[seomaticTrackingEvents][]',
                                        value: 'qr_scan',
                                        on: 'qr_scan' in trackingEvents,
                                        disabled: isOverridden,
                                    }) }}
                                </div>
                                <div>
                                    <strong>{{ "QR Code Scans"|t('shortlink-manager') }}</strong>
                                    <span class="light lr-option-row__desc">{{ "When someone opens the link with ?src=qr"|t('shortlink-manager') }}</span>
                                    <div class="light lr-option-row__desc">{{ "Event name:"|t('shortlink-manager') }} <code>{{ eventPrefix ~ '_qr_scan' }}</code></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Event Prefix #}
                    {{ forms.textField({
                        label: "Event Prefix"|t('shortlink-manager'),
                        instructions: "Enter only the prefix, for example {prefix}. Event names are generated automatically."|t('shortlink-manager', { prefix: 'short_links' }),
                        id: 'seomaticEventPrefix',
                        name: 'settings[seomaticEventPrefix]',
                        value: settings.seomaticEventPrefix ?? 'short_links',
                        placeholder: 'short_links',
                        disabled: settings.isOverriddenByConfig('seomaticEventPrefix'),
                        warning: settings.isOverriddenByConfig('seomaticEventPrefix') ?
                            "This is being overridden by the <code>seomaticEventPrefix</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')|raw : null,
                        errors: (settings is defined and settings) ? settings.getErrors('seomaticEventPrefix') : []
                    }) }}
                </div>

                {# Event Structure Documentation - Collapsible #}
                <details class="lr-integration-details">
                    <summary>
                        {{ "Event Data Structure"|t('shortlink-manager') }}
                        <span class="light">{{ "Click to view the data layer event format"|t('shortlink-manager') }}</span>
                    </summary>
                    {% set eventExamples = [
                        { label: "Redirects"|t('shortlink-manager'), type: 'redirect', source: 'direct' },
                        { label: "QR Code Scans"|t('shortlink-manager'), type: 'qr_scan', source: 'qr' },
                    ] %}
                    {% for example in eventExamples %}
                        <h4>{{ example.label }}</h4>
                        <div class="lr-code-block">
<pre>{{ {
    event: eventPrefix ~ '_' ~ example.type,
    shortlink: {
        code: 'abc123',
        title: 'Summer Promo',
        source: example.source,
        click_type: example.type,
    },
}|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        </div>
                    {% endfor %}
                    <p class="light">{{ "To include event details such as source and link code in Google Analytics 4, map them to event parameters using Google Tag Manager variables."|t('shortlink-manager') }}</p>
                </details>

                {# Help Text #}
                {% include 'lindemannrock-base/_components/info-box' with {
                    type: 'info',
                    variant: 'colored',
                    margin: 'none',
                    message: '<strong>' ~ "How Events Are Sent"|t('shortlink-manager') ~ ':</strong>
                        <ul class="lr-integration-help-list list-disc">
                            <li>' ~ "Events are added to the page’s data layer."|t('shortlink-manager') ~ '</li>
                            <li>' ~ "Configure Google Tag Manager triggers and tags to send these events to Google Analytics 4 or other platforms."|t('shortlink-manager') ~ '</li>
                            <li>' ~ "Analytics tracking must be enabled globally and for the link."|t('shortlink-manager') ~ '</li>
                            <li>' ~ "Direct Redirect skips the intermediate page, so browser tracking events are not generated."|t('shortlink-manager') ~ '</li>
                        </ul>'
                } %}
            {% endblock %}
        {% endembed %}

        {# Redirect Manager Integration #}
        {% set rmInstalled = lrPluginInstalled('redirect-manager') %}
        {% set rmAvailable = lrPluginEnabled('redirect-manager') %}
        {% set rmPluginName = lrPluginName('redirect-manager', 'Redirect Manager') %}
        {% set rmPluginNameHtml = rmPluginName|e %}
        {% set rmIntegrationEnabled = 'redirect-manager' in (settings.enabledIntegrations ?? []) %}
        {% set rmEvents = settings.redirectManagerEvents ?? ['slug-change'] %}

        {% embed 'lindemannrock-base/_partials/integration-card' with {
            title: "{pluginName} Integration"|t('shortlink-manager', { pluginName: rmPluginName }),
            description: "Create permanent redirect records when {pluginName} slugs change. Provides centralized redirect management and analytics tracking."|t('shortlink-manager', {pluginName: shortlinkPluralLowerNameHtml}),
            available: rmAvailable,
            installed: rmInstalled,
            installUrl: 'https://github.com/LindemannRock/craft-redirect-manager',
            statusLabels: {
                active: 'Installed & Active'|t('shortlink-manager'),
                disabled: 'Installed but Disabled'|t('shortlink-manager'),
                notInstalled: 'Not Installed'|t('shortlink-manager'),
                install: 'Install Plugin'|t('shortlink-manager'),
            },
            toggleId: 'enableRedirectManagerIntegration',
            toggleName: 'enableRedirectManagerIntegration',
            toggleOn: rmIntegrationEnabled,
            toggleDisabled: not rmAvailable or settings.isOverriddenByConfig('enabledIntegrations'),
            bodyId: 'redirect-manager-settings',
            bodyVisible: rmIntegrationEnabled,
        } %}
            {% block body %}
                {% import "_includes/forms" as forms %}

                {% if settings.isOverriddenByConfig('enabledIntegrations') %}
                    {% include 'lindemannrock-base/_components/config-override-warning' with {
                        message: "This is being overridden by the <code>enabledIntegrations</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')
                    } only %}
                {% endif %}

                {# Configuration Section #}
                <div class="lr-integration-section">
                    <h4 class="lr-integration-section__title">{{ "Configuration"|t('shortlink-manager') }}</h4>

                    {% set isOverridden = settings.isOverriddenByConfig('redirectManagerEvents') %}

                    <div class="field">
                        <div class="heading">
                            <label>{{ "Automatic Redirect Creation"|t('shortlink-manager') }}</label>
                            <div class="instructions">
                                <p>{{ "Select which events should create permanent redirects in {pluginName}"|t('shortlink-manager', { pluginName: rmPluginName }) }}</p>
                            </div>
                        </div>

                        {% if isOverridden %}
                            {% include 'lindemannrock-base/_components/config-override-warning' with {
                                message: "This is being overridden by the <code>redirectManagerEvents</code> setting in <code>config/shortlink-manager.php</code>."|t('shortlink-manager')
                            } only %}
                        {% endif %}

                        <div class="lr-option-rows">
                            {# Slug Changes #}
                            <div class="lr-option-row">
                                <div class="lr-flex-none">
                                    {{ forms.lightswitchField({
                                        label: false,
                                        id: 'redirectManagerEvents-slug-change',
                                        name: 'settings[redirectManagerEvents][]',
                                        value: 'slug-change',
                                        on: 'slug-change' in rmEvents,
                                        disabled: isOverridden,
                                    }) }}
                                </div>
                                <div>
                                    <strong>{{ "Slug Changes"|t('shortlink-manager') }}</strong>
                                    <span class="light lr-option-row__desc">{{ "Change slug from <code>summer-sale</code> to <code>fall-sale</code> → Creates <code>/s/summer-sale</code> → <code>/s/fall-sale</code>"|t('shortlink-manager')|raw }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Help Text #}
                {% include 'lindemannrock-base/_components/info-box' with {
                    type: 'info',
                    variant: 'colored',
                    margin: 'none',
                    message: '<strong>' ~ "Benefits of This Integration"|t('shortlink-manager') ~ ':</strong>
                        <ul class="lr-integration-help-list lr-integration-help-list--flush">
                            <li>
                                <strong>' ~ "Centralized Management"|t('shortlink-manager') ~ '</strong> –
                                ' ~ "View and manage all redirects ({pluginName} + regular pages) in one place"|t('shortlink-manager', {pluginName: shortlinkPluralLowerNameHtml}) ~ '
                            </li>
                            <li>
                                <strong>' ~ "Analytics Tracking"|t('shortlink-manager') ~ '</strong> –
                                ' ~ "Track how many people access old {pluginName} slugs after changes"|t('shortlink-manager', {pluginName: shortlinkPluralLowerNameHtml}) ~ '
                            </li>
                            <li>
                                <strong>' ~ "Persistent Redirects"|t('shortlink-manager') ~ '</strong> –
                                ' ~ "Slug change redirects remain active permanently, preventing broken links"|t('shortlink-manager') ~ '
                            </li>
                            <li>
                                <strong>' ~ "Source Tracking"|t('shortlink-manager') ~ '</strong> –
                                ' ~ "{rmPluginName} shows which plugin created each redirect for better organization"|t('shortlink-manager', {rmPluginName: rmPluginNameHtml}) ~ '
                            </li>
                        </ul>'
                } %}
            {% endblock %}
        {% endembed %}

        {# Hidden field to track enabled integrations #}
        {% set enabledIntegrationsArray = [] %}
        {% if seomaticAvailable and seomaticIntegrationEnabled %}
            {% set enabledIntegrationsArray = enabledIntegrationsArray|merge(['seomatic']) %}
        {% endif %}
        {% if rmAvailable and rmIntegrationEnabled %}
            {% set enabledIntegrationsArray = enabledIntegrationsArray|merge(['redirect-manager']) %}
        {% endif %}

        <input type="hidden"
               name="settings[enabledIntegrations]"
               value="{{ enabledIntegrationsArray|json_encode }}"
               id="enabledIntegrationsField">

        {% js %}
            // Rebuild the aggregate enabled-integrations hidden field from the
            // per-integration switches. Card body show/hide is handled in base
            // components.js (lrIntegrationCards).
            function updateEnabledIntegrations() {
                var integrations = [];

                if ($('#enableSeomaticIntegration').length && $('#enableSeomaticIntegration').find('input[type="hidden"]').val() === '1') {
                    integrations.push('seomatic');
                }

                if ($('#enableRedirectManagerIntegration').length && $('#enableRedirectManagerIntegration').find('input[type="hidden"]').val() === '1') {
                    integrations.push('redirect-manager');
                }

                $('#enabledIntegrationsField').val(JSON.stringify(integrations));
            }

            $('#enableSeomaticIntegration').on('change', updateEnabledIntegrations);
            $('#enableRedirectManagerIntegration').on('change', updateEnabledIntegrations);
        {% endjs %}

    {% include 'lindemannrock-base/_components/plugin-credit.twig' %}
{% endblock %}
