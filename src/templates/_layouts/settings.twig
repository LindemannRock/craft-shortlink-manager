{% extends "_layouts/cp" %}

{% set title = title ?? 'Settings'|t('shortlink-manager') %}
{% set docTitle =  title ~  ' - ' ~ shortlinkHelper.fullName %}
{% set selectedSettingsItem = selectedSettingsItem ?? 'general' %}
{% set selectedSubnavItem = 'settings' %}

{% set setupIncompleteSummary = include('shortlink-manager/_partials/setup-incomplete-summary', {
    selectedSubnavItem: selectedSubnavItem,
    setupStatus: setupStatus ?? null,
}, false)|trim %}
{% set validationSummary = '' %}
{% if settings is defined and settings.hasErrors() %}
    {% set validationSummary = include('lindemannrock-base/_partials/error-summary', {
        errors: settings.getErrors(),
        linkMode: 'field-id',
    })|trim %}
{% endif %}
{% set errorSummary = (setupIncompleteSummary ~ validationSummary)|trim %}

{% block sidebar %}
    <nav id="settings-nav">
        <ul>
            <li>
                <a href="{{ url('shortlink-manager/settings/general') }}" {% if selectedSettingsItem == 'general' %}class="sel"{% endif %}>
                    {{ 'General'|t('shortlink-manager') }}
                </a>
            </li>
            <li>
                <a href="{{ url('shortlink-manager/settings/qr-code') }}" {% if selectedSettingsItem == 'qr-code' %}class="sel"{% endif %}>
                    {{ 'QR Code'|t('shortlink-manager') }}
                </a>
            </li>
            <li>
                <a href="{{ url('shortlink-manager/settings/behavior') }}" {% if selectedSettingsItem == 'behavior' %}class="sel"{% endif %}>
                    {{ 'Behavior'|t('shortlink-manager') }}
                </a>
            </li>
            <li>
                <a href="{{ url('shortlink-manager/settings/analytics') }}" {% if selectedSettingsItem == 'analytics' %}class="sel"{% endif %}>
                    {{ 'Analytics'|t('shortlink-manager') }}
                </a>
            </li>
            <li>
                <a href="{{ url('shortlink-manager/settings/interface') }}" {% if selectedSettingsItem == 'interface' %}class="sel"{% endif %}>
                    {{ 'Interface'|t('shortlink-manager') }}
                </a>
            </li>
            <li>
                <a href="{{ url('shortlink-manager/settings/cache') }}" {% if selectedSettingsItem == 'cache' %}class="sel"{% endif %}>
                    {{ 'Cache'|t('shortlink-manager') }}
                </a>
            </li>
            <li>
                <a href="{{ url('shortlink-manager/settings/integrations') }}" {% if selectedSettingsItem == 'integrations' %}class="sel"{% endif %}>
                    {{ 'Integrations'|t('shortlink-manager') }}
                </a>
            </li>
            <li>
                <a href="{{ url('shortlink-manager/settings/field-layout') }}" {% if selectedSettingsItem == 'field-layout' %}class="sel"{% endif %}>
                    {{ 'Field Layout'|t('shortlink-manager') }}
                </a>
            </li>
        </ul>
    </nav>
{% endblock %}
