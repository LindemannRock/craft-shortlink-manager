{% import "_includes/forms" as forms %}

{{ forms.selectField({
    label: "Link Type"|t('shortlink-manager'),
    instructions: "Should the code be auto-generated or allow custom vanity URLs?"|t('shortlink-manager'),
    id: 'linkType',
    name: 'linkType',
    value: field.linkType,
    options: {
        'code': 'Auto-generated Code'|t('shortlink-manager'),
        'vanity': 'Custom Vanity URL'|t('shortlink-manager'),
    },
}) }}

{{ forms.selectField({
    label: "Default HTTP Code"|t('shortlink-manager'),
    instructions: "Default redirect type for {pluginName} created with this field"|t('shortlink-manager', {pluginName: shortlinkHelper.pluralLowerDisplayName}),
    id: 'defaultHttpCode',
    name: 'defaultHttpCode',
    value: field.defaultHttpCode,
    options: {
        301: '301 - Permanent Redirect'|t('shortlink-manager'),
        302: '302 - Temporary Redirect'|t('shortlink-manager'),
        307: '307 - Temporary Redirect'|t('shortlink-manager'),
        308: '308 - Permanent Redirect'|t('shortlink-manager'),
    },
}) }}

{% include 'lindemannrock-base/_components/info-box' with {
    boxId: 'defaultHttpCodeWarningBox',
    message: '301/308 may be cached by browsers, CDNs, and hosting layers. When analytics tracking is enabled, repeat hits may bypass Craft and not be recorded. Use 302/307 when per-hit analytics accuracy matters.'|t('shortlink-manager'),
    type: 'warning',
    variant: 'colored',
    margin: 'top',
    hidden: field.defaultHttpCode not in [301, 308],
} %}

{% js %}
(() => {
    const defaultHttpCodeSelect = document.getElementById('defaultHttpCode');
    const defaultHttpCodeWarningBox = document.getElementById('defaultHttpCodeWarningBox');

    function updateDefaultHttpCodeWarning() {
        if (!defaultHttpCodeSelect || !defaultHttpCodeWarningBox) {
            return;
        }

        const code = parseInt(defaultHttpCodeSelect.value, 10);
        defaultHttpCodeWarningBox.style.display = [301, 308].includes(code) ? '' : 'none';
    }

    if (defaultHttpCodeSelect) {
        defaultHttpCodeSelect.addEventListener('change', updateDefaultHttpCodeWarning);
        updateDefaultHttpCodeWarning();
    }
})();
{% endjs %}
