{% import "_includes/forms" as forms %}

{% set code = shortLink ? shortLink.code : (value ?? '') %}
{% set shortLinkUrl = shortLink ? shortLink.getUrl() : '' %}
{% set plugin = craft.app.plugins.getPlugin('shortlink-manager') %}
{% set currentSiteId = element.siteId ?? craft.app.sites.currentSite.id %}
{% set isPluginEnabledForSite = plugin.settings.isSiteEnabled(currentSiteId) %}

<div class="shortlink-field">
    {% if not isPluginEnabledForSite %}
        <p class="light">
            {% include 'lindemannrock-base/_components/status-dot' with {
                value: 'disabled',
                colorSet: 'status',
            } only %}
            {{ "{pluginName} is not enabled for this site."|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}
        </p>
    {% else %}
    {# Code Input - shown differently based on field.linkType setting #}
    {% if not shortLink %}
        {# Before save - show appropriate input based on field settings #}
        {% if field.linkType == 'code' %}
            {# Auto-generated mode #}
            <div class="field">
                <div class="heading">
                    <label>{{ "Code"|t('shortlink-manager') }}</label>
                </div>
                <div class="input">
                    <p class="light">{{ "Will be auto-generated when you save"|t('shortlink-manager') }}</p>
                    <input type="hidden" id="{{ name }}-code" name="{{ name }}" value="">
                </div>
            </div>
        {% else %}
            {# Vanity mode #}
            {{ forms.textField({
                label: "Code"|t('shortlink-manager'),
                instructions: "Enter a custom memorable code (e.g., 'pricing' or 'promo-2025'). Letters, numbers, hyphens, and underscores only."|t('shortlink-manager'),
                id: name ~ '-code',
                name: name,
                value: code,
                placeholder: 'my-link',
            }) }}
        {% endif %}
    {% else %}
        {# After save - show the code with info #}
        <code style="font-size: 14px; background: #f3f4f6; padding: 8px 12px; border-radius: 4px; display: inline-block;">{{ shortLink.code }}</code>
        <p class="light lr-mt-8">
            {% set status = shortLink.getStatus() %}
            {% if status == 'disabled' %}
                {% include 'lindemannrock-base/_components/status-dot' with {
                    value: 'disabled',
                    colorSet: 'status',
                } only %}
                {{ "Disabled for this site"|t('shortlink-manager') }}
            {% elseif status == 'expired' %}
                {% include 'lindemannrock-base/_components/status-dot' with {
                    value: 'expired',
                    colorSet: 'status',
                } only %}
                {{ "Expired"|t('shortlink-manager') }}
            {% elseif status == 'pending' %}
                {% include 'lindemannrock-base/_components/status-dot' with {
                    value: 'pending',
                    colorSet: 'status',
                } only %}
                {{ "Pending"|t('shortlink-manager') }}
            {% else %}
                {% if shortLink.linkType == 'code' %}
                    {{ "Auto-generated"|t('shortlink-manager') }}. <a href="{{ cpUrl('shortlink-manager/shortlinks/' ~ shortLink.id) }}" class="go">{{ "Edit to regenerate"|t('shortlink-manager') }}</a>
                {% else %}
                    {{ "Custom vanity URL"|t('shortlink-manager') }}
                {% endif %}
            {% endif %}
        </p>
    {% endif %}
    {% endif %}
</div>
