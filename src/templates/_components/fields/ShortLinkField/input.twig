{% import "_includes/forms" as forms %}

{% set code = shortLink ? shortLink.code : (value ?? '') %}
{% set shortLinkUrl = shortLink ? shortLink.getUrl() : '' %}

<div class="shortlink-field">
    {# Code Input - shown differently based on field.linkType setting #}
    {% if not shortLink %}
        {# Before save - show appropriate input based on field settings #}
        {% if field.linkType == 'code' %}
            {# Auto-generated mode #}
            <div class="field">
                <div class="heading">
                    <label>{{ "Code"|t('shortlink-manager') }}</label>
                </div>
                <div class="input">
                    <p class="light">{{ "Will be auto-generated when you save"|t('shortlink-manager') }}</p>
                    <input type="hidden" id="{{ name }}-code" name="{{ name }}" value="">
                </div>
            </div>
        {% else %}
            {# Vanity mode #}
            {{ forms.textField({
                label: "Code"|t('shortlink-manager'),
                instructions: "Enter a custom memorable code (e.g., 'pricing' or 'promo-2025'). Letters, numbers, hyphens, and underscores only."|t('shortlink-manager'),
                id: name ~ '-code',
                name: name,
                value: code,
                placeholder: 'my-link',
            }) }}
        {% endif %}
    {% else %}
        {# After save - show the code (read-only info) #}
        <div class="field">
            <div class="heading">
                <label>{{ "Code"|t('shortlink-manager') }}</label>
            </div>
            <div class="input">
                <code style="font-size: 14px; background: #f3f4f6; padding: 8px 12px; border-radius: 4px; display: inline-block;">{{ shortLink.code }}</code>
                <p class="light" style="margin-top: 8px;">{{ shortLink.linkType == 'code' ? 'Auto-generated'|t('shortlink-manager') : 'Custom vanity URL'|t('shortlink-manager') }}</p>
            </div>
        </div>
    {% endif %}

    {% if shortLink %}
        {% set status = shortLink.getStatus() %}
        {% if status == 'disabled' %}
            <p class="light">
                <span class="status disabled"></span>
                {{ "{pluginName} is disabled for this site. See sidebar to manage."|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}
            </p>
        {% elseif status == 'expired' %}
            <p class="light">
                <span class="status expired"></span>
                {{ "{pluginName} has expired. See sidebar for details."|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}
            </p>
        {% elseif status == 'pending' %}
            <p class="light">
                <span class="status pending"></span>
                {{ "{pluginName} is pending (future post date). See sidebar for details."|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}
            </p>
        {% else %}
            <p class="light">
                {{ "{pluginName} created successfully. See sidebar for details."|t('shortlink-manager', {pluginName: shortlinkHelper.displayName}) }}
            </p>
        {% endif %}

        {% if field.enableExpiration %}
            {{ forms.dateTimeField({
                label: "Expires At"|t('shortlink-manager'),
                id: name ~ '-dateExpired',
                name: name ~ '[dateExpired]',
                value: shortLink.dateExpired,
            }) }}
        {% endif %}
    {% endif %}
</div>
