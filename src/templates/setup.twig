{% extends "shortlink-manager/_layouts/cp" %}

{% set selectedSubnavItem = 'setup' %}
{% set title = "Set up ShortLink Manager"|t('shortlink-manager') %}

{% set missingTemplates = templateStatuses|filter(status => not status.exists) %}
{% set templatesReady = missingTemplates|length == 0 %}
{% set allComplete = ipSaltConfigured and templatesReady %}

{% set ipSaltIncompleteBody %}
    <p>
        {{ 'Analytics tracking requires a secure salt for privacy protection.'|t('lindemannrock-base') }}
    </p>
    <p>
        <strong>{{ 'Run one of these commands in your terminal:'|t('lindemannrock-base') }}</strong>
    </p>
{% endset %}

{% set ipSaltFooter %}
    <p>
        {{ 'This will automatically add {envVar} to your .env file.'|t('lindemannrock-base', {envVar: '<code>SHORTLINK_MANAGER_IP_SALT</code>'})|raw }}
    </p>
    <p>
        <strong>{{ 'Warning:'|t('lindemannrock-base') }}</strong>
        {{ 'Copy the same salt to staging and production environments.'|t('lindemannrock-base') }}
    </p>
{% endset %}

{% set templateCompleteBody %}
    <p>{{ 'All required frontend templates are available.'|t('shortlink-manager') }}</p>
{% endset %}

{% set templatesIncompleteBody %}
    <p>
        {{ (missingTemplates|length == 1 ? 'Copy the missing starter template before public links can render this frontend page.' : 'Copy the missing starter templates before public links can render redirect, expired, or QR pages.')|t('shortlink-manager') }}
    </p>
    <p>
        <strong>{{ 'Run one of these commands in your terminal:'|t('lindemannrock-base') }}</strong>
    </p>
{% endset %}

{% set selectedTemplate = missingTemplates|length == 1 ? missingTemplates|first : null %}
{% set templateCopyOption = selectedTemplate ? ' --template=' ~ selectedTemplate.key : '' %}
{% set templateCopyCommands = [
    {
        legend: 'Standard:'|t('lindemannrock-base'),
        value: 'php craft shortlink-manager/setup/copy-templates' ~ templateCopyOption,
        copyLabel: 'Copy'|t('lindemannrock-base'),
        copiedMessage: 'Copied!'|t('lindemannrock-base'),
    },
    {
        legend: 'DDEV:'|t('lindemannrock-base'),
        value: 'ddev craft shortlink-manager/setup/copy-templates' ~ templateCopyOption,
        copyLabel: 'Copy'|t('lindemannrock-base'),
        copiedMessage: 'Copied!'|t('lindemannrock-base'),
    },
] %}

{% set templatesFooter %}
    <p>
        <strong>{{ 'Warning:'|t('lindemannrock-base') }}</strong>
        {{ 'Review and customize the copied templates before going live.'|t('shortlink-manager') }}
    </p>
{% endset %}

{% set setupConfig = {
    plugin: {
        handle: 'shortlink-manager',
        name: shortlinkHelper.fullName,
        version: pluginVersion ? ('v{version}'|t('shortlink-manager', {version: pluginVersion})) : null,
        iconSvg: pluginIconSvg,
        logoPaths: logoPaths,
        heroStyle: pluginHeroStyle,
    },
    page: {
        badge: allComplete ? 'Ready'|t('shortlink-manager') : 'Setup'|t('shortlink-manager'),
        title: shortlinkHelper.fullName,
        description: 'Complete these steps before creating public short links and QR landing pages.'|t('shortlink-manager'),
    },
    tasks: [
        {
            done: ipSaltConfigured,
            heading: 'IP salt'|t('shortlink-manager'),
            description: ipSaltConfigured ? 'Analytics privacy salt is ready for public link tracking.'|t('shortlink-manager') : 'Analytics needs a privacy salt before public link tracking is ready.'|t('shortlink-manager'),
            complete: {
                heading: 'IP hash salt is configured.'|t('shortlink-manager'),
                body: 'Analytics privacy salt is ready for public link tracking.'|t('shortlink-manager'),
            },
            incomplete: {
                heading: 'IP hash salt is missing.'|t('lindemannrock-base'),
                bodyHtml: ipSaltIncompleteBody,
                commands: [
                    {
                        legend: 'Standard:'|t('lindemannrock-base'),
                        value: 'php craft shortlink-manager/security/generate-salt',
                        copyLabel: 'Copy'|t('lindemannrock-base'),
                        copiedMessage: 'Copied!'|t('lindemannrock-base'),
                    },
                    {
                        legend: 'DDEV:'|t('lindemannrock-base'),
                        value: 'ddev craft shortlink-manager/security/generate-salt',
                        copyLabel: 'Copy'|t('lindemannrock-base'),
                        copiedMessage: 'Copied!'|t('lindemannrock-base'),
                    },
                ],
                footerHtml: ipSaltFooter,
            },
        },
        {
            done: templatesReady,
            heading: 'Starter templates'|t('shortlink-manager'),
            description: templatesReady ? 'All required frontend templates are available.'|t('shortlink-manager') : 'Copy the starter templates before public short links can render their frontend pages.'|t('shortlink-manager'),
            complete: {
                heading: 'Starter templates are ready.'|t('shortlink-manager'),
                bodyHtml: templateCompleteBody,
            },
            incomplete: {
                heading: (missingTemplates|length == 1 ? 'Starter template is missing.' : 'Starter templates are missing.')|t('shortlink-manager'),
                bodyHtml: templatesIncompleteBody,
                commands: templateCopyCommands,
                footerHtml: templatesFooter,
            },
        },
    ],
} %}

{% block content %}
    {% embed 'lindemannrock-base/_layouts/cp-plugin-setup' with {
        setupConfig: setupConfig,
        allComplete: allComplete,
        ipSaltConfigured: ipSaltConfigured,
        templatesReady: templatesReady,
        templateStatuses: templateStatuses,
        missingTemplates: missingTemplates,
        pluginIconSvg: pluginIconSvg,
        pluginHeroStyle: pluginHeroStyle,
        logoPaths: logoPaths,
    } only %}
        {% block summary %}
            {% if allComplete %}
                {% include 'lindemannrock-base/_components/info-box' with {
                    message: '<strong>' ~ 'Setup complete.'|t('shortlink-manager') ~ '</strong> ' ~ 'ShortLink Manager is ready to create public short links and QR landing pages.'|t('shortlink-manager'),
                    type: 'success',
                    variant: 'colored',
                    margin: 'none',
                    allowHtml: true,
                } only %}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
