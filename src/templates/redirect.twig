{#
  ShortLink redirect template.

  Rendered only when Direct Redirect is off. Keep the manual link and redirect
  script pointed at `goUrl`; that tracked hop records analytics before sending
  the visitor to the final destination. SEOmatic tracking is handled by
  `renderRedirectSeomaticTracking()`, which returns nothing when unavailable.
#}
<!DOCTYPE html>
<html lang="{{ currentSite.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex,nofollow">

    <title>{{ shortLink.title|default('Redirecting...') }} - {{ siteName }}</title>

    {{ shortLink.renderRedirectSeomaticTracking() }}

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
            max-width: 480px;
            width: 100%;
            padding: 40px;
            text-align: center;
        }

        .loader {
            width: 60px;
            height: 60px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 30px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        h1 {
            font-size: 24px;
            margin-bottom: 10px;
            color: #333;
        }

        .message {
            color: #666;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .fallback-link {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 24px;
            background-color: #007AFF;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: background-color 0.2s ease;
        }

        .fallback-link:hover {
            background-color: #0051D5;
        }

        @media (prefers-color-scheme: dark) {
            body {
                background-color: #1a1a1a;
            }

            .container {
                background: #2a2a2a;
                box-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
            }

            h1 {
                color: #f0f0f0;
            }

            .message {
                color: #aaa;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="loader"></div>
        <h1>{{ shortLink.title|default('Redirecting...') }}</h1>
        <p class="message">
            {{ 'Please wait, redirecting you now...'|t('shortlink-manager') }}
        </p>
        <a href="{{ goUrl|e('html_attr') }}" class="fallback-link" id="manual-link">
            {{ 'Click here if not redirected'|t('shortlink-manager') }}
        </a>
    </div>

	{# Cache-safe redirect helper. Pass true only in custom/staging templates to allow ?debug=1 outside devMode. #}
	{{ shortLink.renderRedirectScript() }}
</body>
</html>
