{% set rows = [] %}

{% for shortLink in shortLinks %}
    {% set domain = shortLink.destinationUrl|split('://')|last|split('/')|first %}
    {% set meta %}
        <a href="{{ shortLink.destinationUrl }}" target="_blank" rel="noopener" title="{{ shortLink.destinationUrl }}">{{ domain }}</a>
    {% endset %}
    {% set rows = rows|merge([{
        primary: shortLink.code,
        primaryUrl: cpUrl('shortlink-manager/shortlinks/' ~ shortLink.id),
        metaHtml: meta,
        value: shortLink.clicks|number,
    }]) %}
{% endfor %}

{% include 'lindemannrock-base/_components/dashboard-widget-list' with {
    primaryHeader: "Link"|t('shortlink-manager'),
    valueHeader: "Interactions"|t('shortlink-manager'),
    rows: rows,
    empty: {
        title: "No {pluginName} yet"|t('shortlink-manager', {pluginName: shortlinkHelper.pluralLowerDisplayName}),
        message: "Create your first {singularName} to see it here."|t('shortlink-manager', {singularName: shortlinkHelper.lowerDisplayName}),
    },
    footer: {
        url: cpUrl('shortlink-manager/shortlinks'),
        label: "View all {pluginName}"|t('shortlink-manager', {pluginName: shortlinkHelper.pluralLowerDisplayName}),
    },
} only %}
