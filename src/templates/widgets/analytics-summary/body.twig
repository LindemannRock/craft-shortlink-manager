{% if data.topLinks|length > 0 %}
    {% set topLink = data.topLinks|first %}
    {% set domain = topLink.destinationUrl|split('://')|last|split('/')|first %}
    {% set topMeta %}
        <a href="{{ topLink.destinationUrl }}" target="_blank" rel="noopener" title="{{ topLink.destinationUrl }}">{{ domain }}</a>
        <span class="lr-dashboard-widget-meta__separator">•</span>
        <span>{{ topLink.clicks|number }} {{ "interactions"|t('shortlink-manager') }}</span>
    {% endset %}

    {% set topItem = {
        label: "Top Performer"|t('shortlink-manager'),
        title: topLink.code,
        url: cpUrl('shortlink-manager/shortlinks/' ~ topLink.id),
        metaHtml: topMeta,
    } %}
{% else %}
    {% set topItem = null %}
{% endif %}

{% include 'lindemannrock-base/_components/dashboard-widget-stats' with {
    stats: [
        {value: data.totalClicks, label: "Total Interactions"|t('shortlink-manager')},
        {value: data.uniqueVisitors, label: "Unique Visitors"|t('shortlink-manager')},
        {value: data.activeLinks, label: "Active Links"|t('shortlink-manager')},
        {value: data.linksUsedPercentage ?? 0, suffix: '%', label: "Engagement Rate"|t('shortlink-manager')},
    ],
    topItem: topItem,
    footer: {
        url: cpUrl('shortlink-manager/analytics'),
        label: "View full analytics"|t('shortlink-manager'),
    },
} only %}
